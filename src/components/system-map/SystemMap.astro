	.system-map__ring--fill1 { stroke: none; opacity: 0.035; }
	.system-map__ring--fill2 { stroke: none; opacity: 0.06; }
	.system-map__ring--fill3 { stroke: none; opacity: 0.11; }
	.system-map__ring--fill4 { stroke: none; opacity: 0.17; }
