	.system-map__caption + .system-map__caption {
		margin-block-start: var(--space-xs);
		opacity: 0.7;
	}

	/* --- Interactive overlay controls ------------------------------------------ */

	.system-map__node-btn {
		position: absolute;
		transform: translate(-50%, -50%);
		left: 0;
		top: 0;
		background: transparent;
		border: none;
		padding: 0;
		margin: 0;
		cursor: pointer;
	}

	.system-map__node-btn:hover,
	.system-map__node-btn:focus-visible {
		outline: 1px dashed var(--color-accent);
		outline-offset: 3px;
	}

	/* Node ids are page-supplied props, unknown at CSS-authoring time, so
	   focus state is driven entirely by the .is-focused/.is-receded classes
	   the script above applies directly — no attribute-value selector keyed
	   to a specific id (that only worked in the A4.3.x prototypes, which had
	   fixed, known node ids). */
	.system-map [data-belongs].is-receded {
