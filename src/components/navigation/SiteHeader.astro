---
import Container from '../layout/Container.astro';
import { getEntry } from 'astro:content';
import { localize, type Locale } from '../../lib/i18n';
import { translateHref } from '../../lib/routes';

interface Props {
	locale?: Locale;
	/**
	 * The equivalent page's URL in the other locale, if one actually exists
	 * and is publishable. When absent, no language-switch link is rendered —
	 * per Task 007B's brief, a locale link must never point at a route that
	 * doesn't exist yet (see DOC/09-TECHNICAL-ARCHITECTURE.md "Localization").
	 */
	alternateLocalePath?: string;
	/**
	 * This page's own resolved path (Task 019), used only to compute
	 * current-page/current-section nav state — never required for the header
	 * to render correctly without it (every existing call site that predates
	 * this prop still works, just with no current-page indication).
	 */
	currentPath?: string;
}

const { locale = 'hu', alternateLocalePath, currentPath } = Astro.props;

const nav = await getEntry('nav', 'main');
if (!nav) throw new Error('Missing required "nav/main" content entry');
const n = nav.data;

const otherLocale: Locale = locale === 'hu' ? 'en' : 'hu';
const LANGUAGE_SWITCH_LABEL: Record<Locale, string> = { hu: 'EN', en: 'HU' };
const LANGUAGE_SWITCH_ARIA: Record<Locale, string> = {
	hu: 'Switch to English',
	en: 'Váltás magyarra',
};

/**
 * Task 019 §24 — current-page/current-section indication. `aria-current="page"`
 * only ever goes on a link whose target *is* the current page (an anchor
 * fragment doesn't change that — `/egyedi-fejlesztes/#custom-applications`
 * and `/egyedi-fejlesztes/` are the same document). A link to a *parent*
 * section the visitor is somewhere underneath (e.g. the "Munkáink"/"Our
 * work" link while actually reading a case-study detail page) gets
 * `aria-current="true"` instead — WAI-ARIA's own generic "current item in a
 * set" token, deliberately not "page", so the semantics stay honest per the
 * task's own explicit instruction not to falsely mark a parent as the exact
 * current page.
 */
function basePath(href: string): string {
	return href.split('#')[0];
}
function currentState(href: string): 'page' | 'section' | undefined {
	if (!currentPath) return undefined;
	const base = basePath(translateHref(href, locale));
	if (currentPath === base) return 'page';
	if (base !== '/' && base !== (locale === 'hu' ? '/' : '/en/') && currentPath.startsWith(base)) return 'section';
	return undefined;
}
---

<a href="#main-content" class="skip-link">{locale === 'hu' ? 'Ugrás a tartalomra' : 'Skip to content'}</a>

<header class="site-header">
	<Container width="wide" as="div">
		<div class="site-header__inner">
			<a href={locale === 'hu' ? '/' : '/en/'} class="site-header__logo">{n.logoLabel}</a>

			<nav class="site-nav" aria-label={localize(n.ariaLabel, locale)}>
				<ul class="site-nav__list">
					<li>
						<details class="nav-dropdown">
							<summary aria-current={currentState('/egyedi-fejlesztes/') === 'page' ? 'true' : undefined}>{localize(n.customDev.summary, locale)}</summary>
							<ul>
								{n.customDev.items.map((item) => {
									const state = currentState(item.href);
									return (
										<li><a href={translateHref(item.href, locale)} aria-current={state === 'page' ? 'page' : undefined}>{localize(item.label, locale)}</a></li>
									);
								})}
							</ul>
						</details>
					</li>
					{n.links.map((link) => {
						const state = currentState(link.href);
						return (
							<li><a href={translateHref(link.href, locale)} aria-current={state === 'page' ? 'page' : state === 'section' ? 'true' : undefined}>{localize(link.label, locale)}</a></li>
						);
					})}
				</ul>
			</nav>

			<a href={translateHref(n.cta.href, locale)} class="btn btn-primary site-header__cta">{localize(n.cta.label, locale)}</a>

			{alternateLocalePath && (
				<a href={alternateLocalePath} class="site-header__lang" aria-label={LANGUAGE_SWITCH_ARIA[locale]} hreflang={otherLocale}>
					{LANGUAGE_SWITCH_LABEL[locale]}
				</a>
			)}

			<details class="mobile-menu">
				<summary class="mobile-menu__trigger" aria-label={localize(n.mobileMenuTriggerAriaLabel, locale)}>
					{localize(n.mobileMenuTriggerText, locale)}
				</summary>
				<ul class="mobile-menu__list">
					{n.customDev.items.map((item) => {
						const state = currentState(item.href);
						return (
							<li><a href={translateHref(item.href, locale)} aria-current={state === 'page' ? 'page' : undefined}>{localize(n.customDev.summary, locale)} — {localize(item.label, locale)}</a></li>
						);
					})}
					{n.links.map((link) => {
						const state = currentState(link.href);
						return (
							<li><a href={translateHref(link.href, locale)} aria-current={state === 'page' ? 'page' : state === 'section' ? 'true' : undefined}>{localize(link.label, locale)}</a></li>
						);
					})}
					<li><a href={translateHref(n.cta.href, locale)}>{localize(n.cta.label, locale)}</a></li>
					{alternateLocalePath && (
						<li><a href={alternateLocalePath} hreflang={otherLocale}>{LANGUAGE_SWITCH_ARIA[locale]}</a></li>
					)}
				</ul>
			</details>
		</div>
	</Container>
</header>
