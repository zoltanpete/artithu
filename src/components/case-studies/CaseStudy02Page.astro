---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../layout/Container.astro';
import SiteHeader from '../navigation/SiteHeader.astro';
import { localize, localizeGated, alternatesFor, type Locale } from '../../lib/i18n';
import { translateHref } from '../../lib/routes';

/**
 * Case Study 02 canonical detail page — `/munkaink/erp-integracio/` (Task
 * 016). Dedicated component, same reasoning as `CaseStudy01Page.astro` — see
 * that file's header comment. This case's real weight sits in "integrations"
 * (the ERP-continuity story) and "business result" (the operational
 * work-surface role), neither of which CS01 uses — the two components
 * genuinely differ in which sections exist, not just in copy. No ERP vendor
 * names, raw connection details, or an exact ERP-replacement count appear
 * anywhere below — see DOC/06's GATED/DO_NOT_PUBLISH rows for this case.
 */
interface Props {
	locale: Locale;
	alternateLocalePath?: string;
}

const { locale, alternateLocalePath } = Astro.props;

const entry = await getEntry('case-studies', 'erp-integracio');
if (!entry) throw new Error('Missing required "case-studies/erp-integracio" content entry');
const c = entry.data;

const shot = (id: string) => c.screenshots.find((s) => s.id === id);
const practiceShot = c.sections.practice?.screenshotId ? shot(c.sections.practice.screenshotId) : undefined;
const integrationsShot = c.sections.integrations?.screenshotId ? shot(c.sections.integrations.screenshotId) : undefined;

const path = translateHref(`/munkaink/${c.slug}/`, locale);
const munkainkPath = translateHref('/munkaink/', locale);
const munkainkLabel = locale === 'hu' ? 'Munkáink' : 'Work';

const breadcrumbJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: munkainkLabel, item: munkainkPath },
		{ '@type': 'ListItem', position: 2, name: localizeGated(c.title, locale) ?? '' },
	],
};
---

<BaseLayout
	title={localizeGated(c.seo.title, locale) ?? ''}
	description={localizeGated(c.seo.description, locale) ?? ''}
	path={path}
	locale={locale}
	alternates={alternatesFor(locale, alternateLocalePath)}
>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} />
	<SiteHeader locale={locale} alternateLocalePath={alternateLocalePath} />

	<main id="main-content" tabindex="-1">
		<!-- 01 — Breadcrumb + Hero. States the "systems changed, the layer
		     remained" thesis directly. -->
		<section class="section section--major">
			<Container width="standard">
				<nav aria-label="Breadcrumb">
					<p class="meta case-breadcrumb">
						<a href={munkainkPath} class="meta">{munkainkLabel}</a>
						<span class="case-breadcrumb__sep" aria-hidden="true">/</span>
						<span>{localizeGated(c.title, locale)}</span>
					</p>
				</nav>
				<p class="eyebrow" style="margin-block-start: var(--space-lg);">
					{localizeGated(c.sections.hero.eyebrow ?? { hu: '' }, locale)}
				</p>
				<h1 style="margin-block-start: var(--space-sm); max-width: var(--content-wide);">
					{localizeGated(c.title, locale)}
				</h1>
				<p class="lead" style="max-width: var(--content-reading); margin-block-start: var(--space-md);">
					{localizeGated(c.sections.hero.statement, locale)}
				</p>
				{c.evidenceBadge && <span class="meta case-hero__badge">{localizeGated(c.evidenceBadge, locale)}</span>}
			</Container>
		</section>

		<hr class="divider" />

		<!-- 02 — Starting situation. -->
		{c.sections.startingSituation && (
			<section class="section">
				<Container width="standard">
					<h2 style="max-width: var(--content-reading);">{localizeGated(c.sections.startingSituation.headline, locale)}</h2>
					<p style="max-width: var(--content-reading); margin-block-start: var(--space-lg);">
						{localizeGated(c.sections.startingSituation.body, locale)}
					</p>
				</Container>
			</section>
		)}

		<hr class="divider" />

		<!-- 03 — Evidence record: practice, integrations, business result, long
		     term. "Integrations" carries real weight here, unlike CS01 —
		     DOC/06's own instruction. -->
		<section class="section section--major">
			<Container width="standard">
				{c.sections.practice && (
					<div class="case-record__row" style="border-block-start: none; padding-block-start: 0;">
						<span class="meta case-record__label">01</span>
						<div>
							<h3>{localizeGated(c.sections.practice.headline, locale)}</h3>
							<p style="margin-block-start: var(--space-sm); max-width: var(--content-reading);">
								{localizeGated(c.sections.practice.body, locale)}
							</p>
							{practiceShot && (
								<figure class="case-frame">
									<Image
										src={practiceShot.image}
										alt={localize(practiceShot.alt, locale)}
										widths={[480, 800, 1200]}
										sizes="(min-width: 900px) 720px, 100vw"
									/>
									{practiceShot.caption && (
										<figcaption class="meta" style="margin-block-start: var(--space-sm);">
											{localizeGated(practiceShot.caption, locale)}
										</figcaption>
									)}
								</figure>
							)}
						</div>
					</div>
				)}

				{c.sections.integrations && (
					<div class="case-record__row">
						<span class="meta case-record__label">02</span>
						<div>
							<h3>{localizeGated(c.sections.integrations.headline, locale)}</h3>
							<p style="margin-block-start: var(--space-sm); max-width: var(--content-reading);">
								{localizeGated(c.sections.integrations.body, locale)}
							</p>
							{integrationsShot && (
								<figure class="case-frame">
									<Image
										src={integrationsShot.image}
										alt={localize(integrationsShot.alt, locale)}
										widths={[480, 800, 1200]}
										sizes="(min-width: 900px) 720px, 100vw"
									/>
									{integrationsShot.caption && (
										<figcaption class="meta" style="margin-block-start: var(--space-sm);">
											{localizeGated(integrationsShot.caption, locale)}
										</figcaption>
									)}
								</figure>
							)}
						</div>
					</div>
				)}

				{c.sections.businessResult && (
					<div class="case-record__row">
						<span class="meta case-record__label">03</span>
						<div>
							<h3>{localizeGated(c.sections.businessResult.headline, locale)}</h3>
							<p style="margin-block-start: var(--space-sm); max-width: var(--content-reading);">
								{localizeGated(c.sections.businessResult.body, locale)}
							</p>
						</div>
					</div>
				)}

				{c.sections.longTerm && (
					<div class="case-record__row">
						<span class="meta case-record__label">04</span>
						<div>
							<h3>{localizeGated(c.sections.longTerm.headline, locale)}</h3>
							<p style="margin-block-start: var(--space-sm); max-width: var(--content-reading);">
								{localizeGated(c.sections.longTerm.body, locale)}
							</p>
						</div>
					</div>
				)}
			</Container>
		</section>

		<hr class="divider" />

		<!-- 04 — What this demonstrates. -->
		{c.sections.learned && (
			<section class="section section--major surface--tonal">
				<Container width="standard">
					<h2 style="max-width: var(--content-reading);">{localizeGated(c.sections.learned.headline, locale)}</h2>
					<p style="max-width: var(--content-reading); margin-block-start: var(--space-lg);">
						{localizeGated(c.sections.learned.body, locale)}
					</p>
				</Container>
			</section>
		)}

		<hr class="divider" />

		<!-- 05 — Cross-links + final CTA. -->
		<section class="section section--major">
			<Container width="standard">
				<p>
					<a href={translateHref(c.directionLink.href, locale)} class="link-standalone">{localizeGated(c.directionLink.label, locale)}</a>
				</p>
				<h2 style="max-width: var(--content-reading); margin-block-start: var(--space-xl);">
					{localizeGated(c.finalCta.headline, locale)}
				</h2>
				<p class="lead" style="max-width: var(--content-reading); margin-block-start: var(--space-md);">
					{localizeGated(c.finalCta.copy, locale)}
				</p>
				<a href={translateHref(c.finalCta.cta.href, locale)} class="btn btn-primary" style="margin-block-start: var(--space-xl);">
					{localizeGated(c.finalCta.cta.label, locale)}
				</a>
			</Container>
		</section>
	</main>
</BaseLayout>
