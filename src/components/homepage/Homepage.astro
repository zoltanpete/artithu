---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../layout/Container.astro';
import SiteHeader from '../navigation/SiteHeader.astro';
import Footer from '../navigation/Footer.astro';
import SystemMap from '../system-map/SystemMap.astro';
import type { SystemMapSource, SystemMapOutput } from '../system-map/SystemMap.astro';
import { localize, localizeGated, homePath, alternatesFor, type Locale } from '../../lib/i18n';
import { translateHref } from '../../lib/routes';

/**
 * Shared homepage renderer (Task 007B). One implementation for every
 * locale — `src/pages/index.astro` and `src/pages/en/index.astro` (Task
 * 018) are both thin wrappers that just pick a `locale`.
 */
interface Props {
	locale: Locale;
	alternateLocalePath?: string;
}

const { locale, alternateLocalePath } = Astro.props;

const page = await getEntry('pages', 'home');
if (!page) throw new Error('Missing required "pages/home" content entry');
const c = page.data;

// Post-launch fix: the Problem section's "JEL / 0X" diagnostic-signal index
// label was a hardcoded Hungarian literal (a real gap — every other
// user-facing string on this page already comes from `c` via
// `localize()`/`localizeGated()`, but this one was written directly into
// the template back when only a HU render existed). Same "tiny internal
// map, not a new content field" treatment as `SystemMap.astro`'s own
// `NODE_HIGHLIGHT_LABEL`/`LEGEND_LABEL` — short, categorical, technical-
// diagram vocabulary, not marketing prose that belongs in `content.yaml`.
const SIGNAL_LABEL: Record<Locale, string> = { hu: 'JEL', en: 'SIGNAL' };
const signalLabel = SIGNAL_LABEL[locale];

// Task 019 §28 — minimal, factual `Organization` JSON-LD, homepage only
// (the canonical entity-defining page, not repeated sitewide). Every
// property is a verified owner-supplied fact (see
// DOC/13-CONTENT-GAPS-AND-VALIDATION.md "Organization") — no `logo` (the
// new favicon is an icon-scale mark, not a suitable Organization logo
// asset; see `12-ASSET-STRATEGY.md`), no `sameAs`/social profiles, no
// `telephone`, no founding date — none of those facts exist yet.
const organizationJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: 'ARTIT Multimédia Kft.',
	url: Astro.site ? Astro.site.toString() : '/',
	email: 'pete.zoltan@gmail.com',
	address: {
		'@type': 'PostalAddress',
		streetAddress: 'Árvalányhaj u. 37.',
		postalCode: '2013',
		addressLocality: 'Pomáz',
		addressCountry: 'HU',
	},
};

const heroSources: SystemMapSource[] = c.hero.systemMap.sources.map((s) => ({
	id: s.id,
	label: localize(s.label, locale),
	icon: s.icon as SystemMapSource['icon'],
	route: s.route,
}));
const heroOutputs: [SystemMapOutput, SystemMapOutput] = [
	{ id: c.hero.systemMap.outputs[0].id, label: localize(c.hero.systemMap.outputs[0].label, locale), icon: c.hero.systemMap.outputs[0].icon as SystemMapOutput['icon'] },
	{ id: c.hero.systemMap.outputs[1].id, label: localize(c.hero.systemMap.outputs[1].label, locale), icon: c.hero.systemMap.outputs[1].icon as SystemMapOutput['icon'] },
];
---

<BaseLayout
	title={localizeGated(c.seo.title, locale) ?? ''}
	description={localizeGated(c.seo.description, locale) ?? ''}
	path={homePath(locale)}
	locale={locale}
	alternates={alternatesFor(locale, alternateLocalePath)}
>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(organizationJsonLd)} />
	<SiteHeader locale={locale} alternateLocalePath={alternateLocalePath} currentPath={homePath(locale)} />

	<main id="main-content" tabindex="-1">
		<!-- 01 — Hero -->
		<section class="hero-map">
			<Container width="wide" as="div">
				<div class="hero-map__grid">
					<div class="hero-map__main">
						<p class="eyebrow">{localizeGated(c.hero.eyebrow, locale)}</p>
						<h1 class="hero-map__h1">
							{localizeGated(c.hero.title, locale)}
						</h1>
						<p class="lead hero-map__lead" style="max-width: var(--content-reading);">
							{localizeGated(c.hero.lead, locale)}
						</p>
						<div class="meta-row hero-map__cta">
							<a href={translateHref(c.hero.primaryCta.href, locale)} class="btn btn-primary">{localizeGated(c.hero.primaryCta.label, locale)}</a>
							<a href={translateHref(c.hero.secondaryCta.href, locale)} class="link-standalone">{localizeGated(c.hero.secondaryCta.label, locale)}</a>
						</div>
					</div>

					<div class="hero-map__visual">
						<SystemMap
							id="hero-system-map"
							sources={heroSources}
							coreLabel={localize(c.hero.systemMap.coreLabel, locale)}
							outputs={heroOutputs}
							mobileSourceIds={c.hero.systemMap.mobileSourceIds}
							caption={localize(c.hero.systemMap.caption, locale)}
							captionSub={localizeGated(c.hero.systemMap.captionSub, locale) ?? undefined}
							ariaLabel={localize(c.hero.systemMap.ariaLabel, locale)}
							locale={locale}
						/>
					</div>
				</div>
			</Container>
		</section>

		<hr class="divider" />

		<!-- 02 — Problem / Recognition. Diagnostic-signal grammar (Task 007C):
		     JEL/0X indexing, a dense tonal-wash field (first 4 signals) against
		     a quieter open field (last 2) — the pattern DOC/07A found validated
		     by the A4/A4.1 exploration and lost in Task 007's production
		     implementation. Same six YAML signals, presentation only. -->
		<section class="section">
			<Container width="standard">
				<p class="eyebrow">{localizeGated(c.problem.eyebrow, locale)}</p>
				<h2 style="margin-block-start: var(--space-sm); max-width: var(--content-reading);">
					{localizeGated(c.problem.headline, locale)}
				</h2>

				<div class="problem-signals">
					<div class="problem-signals__dense surface--tonal">
						{c.problem.signals.slice(0, 4).map((signal, i) => (
							<p class="problem-signals__item" data-signal={signal.id}>
								<span class="meta problem-signals__index">{signalLabel} / {String(i + 1).padStart(2, '0')}</span>
								{localizeGated(signal.quote, locale)}
							</p>
						))}
					</div>
					<div class="problem-signals__open">
						{c.problem.signals.slice(4).map((signal, i) => (
							<p class="problem-signals__item" data-signal={signal.id}>
								<span class="meta problem-signals__index">{signalLabel} / {String(i + 5).padStart(2, '0')}</span>
								{localizeGated(signal.quote, locale)}
							</p>
						))}
					</div>
				</div>

				<p style="max-width: var(--content-reading); margin-block-start: var(--space-xl);">
					{localizeGated(c.problem.closing, locale)}
				</p>

				<a
					href={translateHref(c.problem.link.href, locale)}
					class="link-standalone"
					style="margin-block-start: var(--space-lg);"
				>
					{localizeGated(c.problem.link.label, locale)}
				</a>
			</Container>
		</section>

		<hr class="divider" />

		<!-- 03 — Decision / What ARTIT does. Tonal band + slightly more breathing
		     room (Task 007C): DOC/07A's page-rhythm table locks Decision's
		     surface as "tonal band" — validated by every A4.x iteration as the
		     device that lands the diagnosis → clarity emotional arc — but
		     production had never actually applied it. Content/copy unchanged.
		     Task 007D.1 removed the small fork/branch SVG this section briefly
		     carried (added Task 007, never part of the approved A4 exploration
		     precedent per DOC/07A): it read as a workflow-splitting diagram,
		     but this section describes conceptual alternatives, not an actual
		     process fork — see DOC/07 "Decision / Resolution" for the locked
		     rule. Typography + the two solution directions + the tonal surface
		     are sufficient; no glyph replaces it. -->
		<section class="section section--major surface--tonal">
			<Container width="standard">
				<h2 style="max-width: var(--content-reading);">
					{localizeGated(c.decision.headline, locale)}
				</h2>
				<p class="lead" style="max-width: var(--content-reading); margin-block-start: var(--space-sm);">
					{localizeGated(c.decision.supporting, locale)}
				</p>
				<p style="max-width: var(--content-reading); margin-block-start: var(--space-lg);">
					{localizeGated(c.decision.paragraph, locale)}
				</p>

				<div class="decision-paths">
					{c.decision.paths.map((path) => (
						<div class="decision-paths__path" data-path={path.id}>
							<h3>{localizeGated(path.title, locale)}</h3>
							<p style="margin-block-start: var(--space-sm);">
								{localizeGated(path.description, locale)}
							</p>
							<a
								href={translateHref(path.link.href, locale)}
								class="link-standalone"
								style="margin-block-start: var(--space-md);"
							>
								{localizeGated(path.link.label, locale)}
							</a>
						</div>
					))}
				</div>
			</Container>
		</section>

		<hr class="divider" />

		<!-- 04 — Work. Case-study evidence (real, anonymization-confirmed
		     screenshots and validated facts — see
		     DOC/06-CASE-STUDY-ARCHITECTURE.md) now has a canonical detail page
		     per case (Task 016); each item links directly there when `href` is
		     set, falling back to the /munkaink/ hub link below otherwise. -->
		<section class="section work-teaser">
			<Container width="standard">
				<p class="eyebrow">{localizeGated(c.work.eyebrow, locale)}</p>
				<h2 style="margin-block-start: var(--space-sm); max-width: var(--content-reading);">
					{localizeGated(c.work.headline, locale)}
				</h2>

				<ol class="work-teaser__list">
					{c.work.cases.map((item) => (
						<li class="work-teaser__item panel-technical" data-case={item.id}>
							<span class="meta work-teaser__index">CASE / {String(item.order).padStart(2, '0')}</span>
							{item.href ? (
								<a href={translateHref(item.href, locale)} class="work-teaser__title work-teaser__title--link">
									{localizeGated(item.title, locale)}
								</a>
							) : (
								<p class="work-teaser__title">
									{localizeGated(item.title, locale)}
								</p>
							)}
						</li>
					))}
				</ol>

				<a href={translateHref(c.work.cta.href, locale)} class="link-standalone" style="margin-block-start: var(--space-lg);">
					{localizeGated(c.work.cta.label, locale)}
				</a>
			</Container>
		</section>

		<hr class="divider" />

		<!-- 05 — Longevity. Exact durations/years are gated (TO VERIFY per
		     DOC/13); only the principle is published. Dark section — the
		     homepage's one deliberate rhythm change, per DOC/07 "Dark
		     sections: use rarely." The small crosshair mark (Task 007C) is the
		     section's minimal technical residue DOC/07A asked for — purely
		     geometric, no coordinate/status text, so it can't read as an
		     invented figure or fabricated live-status claim. -->
		<section class="section section--major section--dark">
			<Container width="standard">
				<svg class="longevity__mark" viewBox="0 0 32 32" aria-hidden="true">
					<path d="M16,2 L16,11 M16,21 L16,30 M2,16 L11,16 M21,16 L30,16" />
					<circle cx="16" cy="16" r="2.5" />
				</svg>
				<h2 style="max-width: var(--content-reading);">
					{localizeGated(c.longevity.headline, locale)}
				</h2>
				<p class="lead" style="max-width: var(--content-reading); margin-block-start: var(--space-md);">
					{localizeGated(c.longevity.statement, locale)}
				</p>
			</Container>
		</section>

		<hr class="divider" />

		<!-- 06 — Tardify. Copy is approved positioning language (DOC/04); no
		     approved Tardify product screenshot exists in the repository yet
		     (see DOC/12), so no image/placeholder stands in for evidence that
		     doesn't exist. Instead the copy sits on a technical "specified
		     plate" (Task 007D refinement of Task 007C's original bordered-box
		     attempt, which read too much like a generic card): a top rule +
		     one small accent registration-mark bracket (SystemMap's corner-
		     mark vocabulary, reused here) instead of a full four-side box,
		     plus the Task 007C CTA port dots — so the section reads as
		     structured owned proof rather than a plain aside or a UI card,
		     without fabricating a screenshot or a status claim. -->
		<section class="section">
			<Container width="standard">
				<div class="tardify-proof">
					<svg class="tardify-proof__mark" viewBox="0 0 22 22" aria-hidden="true">
						<path d="M22,0 L22,8 M22,0 L14,0" />
					</svg>
					<p class="eyebrow">{localizeGated(c.tardify.eyebrow, locale)}</p>
					<h2 style="margin-block-start: var(--space-sm); max-width: var(--content-reading);">
						{localizeGated(c.tardify.headline, locale)}
					</h2>
					<p class="lead" style="max-width: var(--content-reading); margin-block-start: var(--space-md);">
						{localizeGated(c.tardify.lead, locale)}
					</p>
					<div class="meta-row tardify-proof__links">
						{c.tardify.links.map((link) => (
							<a href={link.href} class="link-standalone tardify-proof__link" rel={link.href.startsWith('http') ? 'noopener' : undefined}>
								{localizeGated(link.label, locale)}
							</a>
						))}
					</div>
				</div>
			</Container>
		</section>

		<hr class="divider" />

		<!-- 07 — Process -->
		<section class="section">
			<Container width="standard">
				<p class="eyebrow">{localizeGated(c.process.eyebrow, locale)}</p>
				<h2 style="margin-block-start: var(--space-sm); max-width: var(--content-reading);">
					{localizeGated(c.process.headline, locale)}
				</h2>

				<ol class="process-steps">
					{c.process.steps.map((step) => (
						<li class="process-steps__step" data-step={step.id}>
							<span class="meta">{String(step.order).padStart(2, '0')}</span>
							<p class="process-steps__label">{localizeGated(step.label, locale)}</p>
						</li>
					))}
				</ol>
			</Container>
		</section>

		<hr class="divider" />

		<!-- 08 — Senior / Who. No verified expert name/portrait exists yet
		     (see DOC/13) — copy only, no stock-photo substitute. -->
		<section class="section">
			<Container width="standard">
				<p class="eyebrow">{localizeGated(c.seniorWho.eyebrow, locale)}</p>
				<h2 style="margin-block-start: var(--space-sm); max-width: var(--content-reading);">
					{localizeGated(c.seniorWho.headline, locale)}
				</h2>
				<a href={translateHref(c.seniorWho.cta.href, locale)} class="link-standalone" style="margin-block-start: var(--space-lg);">
					{localizeGated(c.seniorWho.cta.label, locale)}
				</a>
			</Container>
		</section>

		<hr class="divider" />

		<!-- 09 — Final CTA -->
		<section class="section section--major surface--tonal">
			<Container width="standard">
				<h2 style="max-width: var(--content-reading);">
					{localizeGated(c.finalCta.headline, locale)}
				</h2>
				<p class="lead" style="max-width: var(--content-reading); margin-block-start: var(--space-md);">
					{localizeGated(c.finalCta.copy, locale)}
				</p>
				<a href={translateHref(c.finalCta.cta.href, locale)} class="btn btn-primary" style="margin-block-start: var(--space-xl);">
					{localizeGated(c.finalCta.cta.label, locale)}
				</a>
			</Container>
		</section>
	</main>

	<Footer locale={locale} />
</BaseLayout>
