---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/layout/Container.astro';
import SiteHeader from '../../components/navigation/SiteHeader.astro';
import ExperimentalBanner from '../../components/experimental/ExperimentalBanner.astro';

// Task 011 exploration — three page-direction concepts for /tardify/. No
// approved screenshot exists (confirmed: public/ and src/assets/ are both
// empty, and DOC/13 explicitly gates "Approved product screenshots for
// ARTIT site"), so Concept A is necessarily typography + restrained plate,
// not real product evidence. No metric, date, customer, or feature fact is
// invented in any concept.
---

<BaseLayout title="Task 011 — Tardify Concepts" description="Exploration prototype" noindex={true}>
	<SiteHeader />
	<ExperimentalBanner label="TASK 011 — TARDIFY CONCEPTS A / B / C — KÍSÉRLETI NÉZET, NEM VÉGLEGES" />

	<main>
		<!-- Concept A — Product as Proof (no screenshot approved -> typography + plate) -->
		<section class="section section--major">
			<Container width="standard">
				<p class="eyebrow">Concept A — Product as Proof (no screenshot)</p>
				<h2 style="margin-block-start: var(--space-sm); max-width: var(--content-reading);">Nem csak ügyfeleinknek építünk szoftvert.</h2>
				<p class="lead" style="margin-block-start: var(--space-md); max-width: var(--content-reading);">Amit ügyfeleinknek hosszú távú fejleszthetőségről mondunk, azt a saját termékünknél magunkon is számon kérjük.</p>
				<div class="proof-plate">
					<svg class="proof-plate__mark" viewBox="0 0 22 22" aria-hidden="true"><path d="M22,0 L22,8 M22,0 L14,0" /></svg>
					<p class="meta" style="color: var(--color-accent);">SAJÁT TERMÉK</p>
					<p style="margin-block-start: var(--space-sm); max-width: var(--content-reading);">Nincs jóváhagyott termékfotó ehhez a bemutatóhoz — a terméket a rá vonatkozó elvek és a hozzá vezető kapcsolat mutatja be, nem egy kitalált felület.</p>
				</div>
			</Container>
		</section>

		<hr class="divider" />

		<!-- Concept B — Product Lineage / Continuity -->
		<section class="section section--major">
			<Container width="standard">
				<p class="eyebrow">Concept B — Product Lineage / Continuity</p>
				<h2 style="margin-block-start: var(--space-sm); max-width: var(--content-reading);">Folyamatosan fejlesztett termék — nem egy lezárt kiadás.</h2>
				<div class="lineage">
					<div class="lineage__line"></div>
					{Array.from({ length: 6 }).map((_, i) => (
						<div class="lineage__tick" style={`opacity:${(0.4 + (i % 3) * 0.2).toFixed(2)}`}></div>
					))}
				</div>
				<p class="meta" style="text-align:center; margin-block-start: var(--space-sm);">FOLYAMATOS FEJLESZTÉS</p>
			</Container>
		</section>

		<hr class="divider" />

		<!-- Concept C — Owned System / Same Standard (mirrored mark) -->
		<section class="section section--major">
			<Container width="standard">
				<p class="eyebrow">Concept C — Owned System / Same Standard</p>
				<h2 style="margin-block-start: var(--space-sm); max-width: var(--content-reading);">Ugyanaz a mérce — ügyfélrendszerben és saját termékben is.</h2>
				<svg viewBox="0 0 260 120" role="img" aria-label="Két azonos technikai jelölés, amely azt mutatja, hogy ugyanaz a mérce vonatkozik az ügyfélrendszerekre és a saját termékre" style="max-width:320px; margin-inline:auto; display:block;">
					<rect x="20" y="30" width="80" height="60" rx="8" fill="none" stroke="var(--color-accent)" stroke-width="1.5" />
					<text x="60" y="65" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--color-text-muted)">ÜGYFÉL</text>
					<rect x="160" y="30" width="80" height="60" rx="8" fill="none" stroke="var(--color-accent)" stroke-width="1.5" />
					<text x="200" y="65" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--color-text-muted)">TARDIFY</text>
					<line x1="100" y1="60" x2="160" y2="60" stroke="var(--color-border)" stroke-width="1.25" stroke-dasharray="3 3" />
					<text x="130" y="52" text-anchor="middle" font-family="var(--font-mono)" font-size="8" fill="var(--color-text-muted)">=</text>
				</svg>
			</Container>
		</section>
	</main>
</BaseLayout>

<style>
	.proof-plate {
		position: relative;
		margin-block-start: var(--space-xl);
		border-block-start: 1px solid var(--color-border);
		padding-block-start: var(--space-lg);
	}
	.proof-plate__mark {
		position: absolute;
		top: 0;
		right: 0;
		width: 22px;
		height: 22px;
		fill: none;
		stroke: var(--color-accent);
		stroke-width: 1.1;
		opacity: 0.55;
	}
	.lineage {
		position: relative;
		height: 40px;
		margin-block-start: var(--space-xl);
		max-width: 400px;
		margin-inline: auto;
	}
	.lineage__line { position: absolute; left: 0; right: 0; top: 50%; height: 1.5px; background: var(--color-accent); opacity: 0.4; }
	.lineage__tick { position: absolute; top: 50%; transform: translate(-50%, -50%); width: 8px; height: 8px; border-radius: 50%; background: var(--color-accent); }
	.lineage__tick:nth-child(2) { left: 5%; }
	.lineage__tick:nth-child(3) { left: 22%; }
	.lineage__tick:nth-child(4) { left: 41%; }
	.lineage__tick:nth-child(5) { left: 63%; }
	.lineage__tick:nth-child(6) { left: 80%; }
	.lineage__tick:nth-child(7) { left: 95%; }
</style>
