---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/layout/Container.astro';
import SiteHeader from '../../components/navigation/SiteHeader.astro';
import ExperimentalBanner from '../../components/experimental/ExperimentalBanner.astro';

// Desktop graph geometry (viewBox 0 0 980 700) — left→right narrative,
// widened and more spacious than A4.3 per this task's refinement brief.
const INPUT_X = 20;
const INPUT_W = 225;
const INPUT_H = 48;
const INPUT_GAP = 34;
const INPUT_START_Y = 152;

const desktopInputs = [
	{ id: 'excel', label: 'EXCEL', icon: 'table', critical: true },
	{ id: 'email', label: 'E-MAIL', icon: 'mail' },
	{ id: 'kulon', label: 'KÜLÖN RENDSZER', icon: 'system' },
	{ id: 'kezi', label: 'KÉZI ADAT', icon: 'manual' },
	{ id: 'api', label: 'API', icon: 'api' },
].map((input, i) => ({ ...input, y: INPUT_START_Y + i * (INPUT_H + INPUT_GAP) }));

const QUIET_Y = desktopInputs[desktopInputs.length - 1].y + INPUT_H + 40;

const CORE_CX = 560;
const CORE_CY = 340;
const SHELL_W = 280;
const SHELL_H = 132;
const SHELL_X = CORE_CX - SHELL_W / 2;
const SHELL_Y = CORE_CY - SHELL_H / 2;
const CORE_ENTRY_X = SHELL_X;
const CORE_EXIT_X = SHELL_X + SHELL_W;
const INNER_W = 210;
const INNER_H = 64;
const INNER_X = CORE_CX - INNER_W / 2;
const INNER_Y = CORE_CY - INNER_H / 2;

const OUTPUT_X = 760;
const OUTPUT_W = 200;
const OUTPUT_H = 66;

const desktopOutputs = [
	{ id: 'jovahagyas', label: 'JÓVÁHAGYÁS', cy: CORE_CY - 70 },
	{ id: 'szamlazas', label: 'SZÁMLÁZÁS', cy: CORE_CY + 70 },
];

function inputPath(startY: number) {
	return `M${INPUT_X + INPUT_W},${startY} C${INPUT_X + INPUT_W + 100},${startY} ${CORE_ENTRY_X - 50},${CORE_CY} ${CORE_ENTRY_X},${CORE_CY}`;
}

function outputPath(endCy: number) {
	const midY = CORE_CY + (endCy - CORE_CY) * 0.62;
	return `M${CORE_EXIT_X},${CORE_CY} C${CORE_EXIT_X + 44},${CORE_CY} ${OUTPUT_X - 26},${midY} ${OUTPUT_X},${endCy}`;
}
---

<BaseLayout
	title="Art Direction A4.3.1 — System Map Visual Refinement (kísérleti, dev-only)"
	description="Kísérleti art-direction irány — nem publikus, nem végleges."
	noindex={true}
>
	<ExperimentalBanner label="ART DIRECTION A4.3.1 — SYSTEM MAP REFINEMENT" />

	<div class="ad-a431">
		<SiteHeader />

		<main>
			<!-- Hero -->
			<section class="ad-a431-hero">
				<Container width="wide" as="div">
					<div class="ad-a431-hero__grid">
						<div class="ad-a431-hero__main">
							<p class="eyebrow">Amikor a kész szoftver már nem elég.</p>
							<h1 class="ad-a431-hero__h1">
								A szoftver alkalmazkodjon a vállalkozásához.<br />Ne fordítva.
							</h1>
							<p class="lead ad-a431-hero__lead" style="max-width: var(--content-reading);">
								Egyedi webes üzleti alkalmazásokat tervezünk és fejlesztünk olyan
								vállalkozásoknak, amelyek működése már túl speciális az Excelhez
								vagy egy kompromisszumos kész rendszerhez.
							</p>
							<div class="meta-row ad-a431-hero__cta">
								<a href="/kapcsolat/" class="btn btn-primary">Beszéljünk a projektről →</a>
								<a href="/munkaink/" class="link-standalone">Munkáink megtekintése</a>
							</div>
						</div>

						<div class="ad-a431-system" id="ad-a431-system">
							<div class="ad-a431-system__stage">
							<svg width="0" height="0" style="position:absolute;">
								<defs>
									<symbol id="a431-icon-table" viewBox="0 0 16 16">
										<rect x="1" y="1" width="14" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.3" />
										<line x1="1" y1="6.5" x2="15" y2="6.5" stroke="currentColor" stroke-width="1.1" />
										<line x1="1" y1="11" x2="15" y2="11" stroke="currentColor" stroke-width="1.1" />
										<line x1="8" y1="1" x2="8" y2="15" stroke="currentColor" stroke-width="1.1" />
										<rect x="9" y="7.3" width="5.2" height="3.4" class="ad-a431-icon-accent" />
									</symbol>
									<symbol id="a431-icon-mail" viewBox="0 0 16 16">
										<rect x="1" y="3" width="14" height="10" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.3" />
										<path d="M1.5,4 L8,9.5 L14.5,4" fill="none" stroke="currentColor" stroke-width="1.3" />
									</symbol>
									<symbol id="a431-icon-system" viewBox="0 0 16 16">
										<rect x="1" y="5" width="9" height="5.4" rx="2.7" fill="none" stroke="currentColor" stroke-width="1.3" />
										<rect x="6.5" y="5.6" width="9" height="5.4" rx="2.7" fill="none" stroke="currentColor" stroke-width="1.3" />
									</symbol>
									<symbol id="a431-icon-manual" viewBox="0 0 16 16">
										<path d="M4,1.5 L4,12.5 L6.6,10 L8.3,13.8 L10.1,13 L8.4,9.1 L11.4,8.9 Z" fill="currentColor" stroke="none" />
									</symbol>
									<symbol id="a431-icon-api" viewBox="0 0 16 16">
										<path d="M5.6,2.5 L1.6,8 L5.6,13.5" fill="none" stroke="currentColor" stroke-width="1.3" />
										<path d="M10.4,2.5 L14.4,8 L10.4,13.5" fill="none" stroke="currentColor" stroke-width="1.3" />
									</symbol>
									<symbol id="a431-icon-dots" viewBox="0 0 16 16">
										<circle cx="3" cy="8" r="1.3" fill="currentColor" />
										<circle cx="8" cy="8" r="1.3" fill="currentColor" />
										<circle cx="13" cy="8" r="1.3" fill="currentColor" />
									</symbol>
									<symbol id="a431-icon-core" viewBox="0 0 16 16">
										<circle cx="8" cy="8" r="5.4" fill="none" stroke="currentColor" stroke-width="1.3" />
										<circle cx="8" cy="8" r="1.7" fill="currentColor" stroke="none" />
									</symbol>

									<marker id="a431-arrow-accent" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
										<path d="M0,0 L10,5 L0,10 Z" class="ad-a431-arrow-fill ad-a431-arrow-fill--accent" />
									</marker>
									<marker id="a431-arrow-neutral" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5.5" markerHeight="5.5" orient="auto-start-reverse">
										<path d="M0,0 L10,5 L0,10 Z" class="ad-a431-arrow-fill ad-a431-arrow-fill--neutral" />
									</marker>
								</defs>
							</svg>

							<svg
								class="ad-a431-system__svg ad-a431-system__svg--desktop"
								viewBox="0 0 980 700"
								role="img"
								aria-label="Élő rendszertérkép: Excel, e-mail, külön rendszer, kézi adat, API és egyéb szétszórt üzleti bemenetek egy közös FOLYAMAT csomóponton keresztül két rendezett kimenetté, jóváhagyássá és számlázássá alakulnak, balról jobbra haladó folyamatként. Minden bemenet és mindkét kimenet a diagram alatti vezérlőkkel kiemelhető."
							>
								<!-- Subliminal construction/coordinate layer — second-look detail. -->
								<line class="ad-a431-guideline" x1="10" y1={CORE_CY} x2="970" y2={CORE_CY} />
								<line class="ad-a431-guideline" x1={CORE_CX} y1="20" x2={CORE_CX} y2="660" />
								<path class="ad-a431-tick" d={`M${CORE_CX - 10},${CORE_CY} L${CORE_CX + 10},${CORE_CY} M${CORE_CX},${CORE_CY - 10} L${CORE_CX},${CORE_CY + 10}`} />
								<path class="ad-a431-tick ad-a431-tick--origin" d="M32,40 L48,40 M40,32 L40,48" />
								<path class="ad-a431-reg-mark" d={`M${SHELL_X - 16},${SHELL_Y} L${SHELL_X - 16},${SHELL_Y - 16} L${SHELL_X},${SHELL_Y - 16}`} />
								<path class="ad-a431-reg-mark" d={`M${CORE_EXIT_X + 16},${SHELL_Y + SHELL_H} L${CORE_EXIT_X + 16},${SHELL_Y + SHELL_H + 16} L${CORE_EXIT_X},${SHELL_Y + SHELL_H + 16}`} />
								<text class="ad-a431-coord" x="16" y={CORE_CY - 8}>X / 01</text>
								<text class="ad-a431-coord" x="964" y={CORE_CY - 8} text-anchor="end">X / 02</text>
								<text class="ad-a431-coord" x={CORE_CX + 8} y="34">Y / 01</text>
								<text class="ad-a431-coord" x={CORE_CX + 8} y="656">Y / 02</text>

								<!-- Concentric violet rings behind FOLYAMAT — depth without glow. -->
								<circle class="ad-a431-ring ad-a431-ring--fill1" cx={CORE_CX} cy={CORE_CY} r="195" />
								<circle class="ad-a431-ring ad-a431-ring--fill2" cx={CORE_CX} cy={CORE_CY} r="165" />
								<circle class="ad-a431-ring ad-a431-ring--fill3" cx={CORE_CX} cy={CORE_CY} r="135" />
								<circle class="ad-a431-ring ad-a431-ring--fill4" cx={CORE_CX} cy={CORE_CY} r="105" />
								<circle class="ad-a431-ring ad-a431-ring--stroke1" cx={CORE_CX} cy={CORE_CY} r="178" />
								<circle class="ad-a431-ring ad-a431-ring--stroke2" cx={CORE_CX} cy={CORE_CY} r="148" />

								<!-- Quiet secondary source -->
								<path class="ad-a431-line ad-a431-line--quiet" data-belongs="other" d={inputPath(QUIET_Y)} />
								<use href="#a431-icon-dots" class="ad-a431-input__icon ad-a431-input__icon--quiet" data-belongs="other" x={INPUT_X} y={QUIET_Y - 14} width="14" height="14" />
								<text class="ad-a431-label ad-a431-label--quiet" data-belongs="other" x={INPUT_X + 22} y={QUIET_Y}>…ÉS MINDEN MÁS FORRÁS</text>

								<!-- Input relationship paths -->
								{desktopInputs.map((input) => (
									<path
										class={`ad-a431-line${input.critical ? ' ad-a431-line--critical' : ''}`}
										data-belongs={input.id}
										d={inputPath(input.y + INPUT_H / 2)}
										marker-end={`url(#a431-arrow-${input.critical ? 'accent' : 'neutral'})`}
									/>
								))}

								<!-- FOLYAMAT — wide, low, layered transformation node. -->
								<rect class="ad-a431-core-shell" x={SHELL_X} y={SHELL_Y} width={SHELL_W} height={SHELL_H} rx="18" />
								<rect class="ad-a431-core-inner" x={INNER_X} y={INNER_Y} width={INNER_W} height={INNER_H} rx="12" />
								<text class="ad-a431-core-label" x={CORE_CX - 51} y={CORE_CY + 5}>FOLYAMAT</text>
								<use href="#a431-icon-core" class="ad-a431-core-icon" x={CORE_CX + 34} y={CORE_CY - 8} width="16" height="16" />

								<!-- Input containers -->
								{desktopInputs.map((input) => (
									<g class="ad-a431-input__box-group" data-belongs={input.id}>
										<rect
											class={`ad-a431-input__box${input.critical ? ' ad-a431-input__box--critical' : ''}`}
											x={INPUT_X}
											y={input.y}
											width={INPUT_W}
											height={INPUT_H}
											rx="8"
										/>
										<use
											href={`#a431-icon-${input.icon}`}
											class="ad-a431-input__icon"
											data-belongs={input.id}
											x={INPUT_X + 16}
											y={input.y + INPUT_H / 2 - 8}
											width="16"
											height="16"
										/>
										<text class="ad-a431-label" data-belongs={input.id} x={INPUT_X + 42} y={input.y + INPUT_H / 2 + 4}>{input.label}</text>
										<circle class="ad-a431-port" data-belongs={input.id} cx={INPUT_X + INPUT_W} cy={input.y + INPUT_H / 2} r="4" />
									</g>
								))}

								<!-- Output relationship paths + containers -->
								{desktopOutputs.map((output) => (
									<path class="ad-a431-line ad-a431-line--resolved" data-belongs={output.id} d={outputPath(output.cy)} marker-start="url(#a431-arrow-accent)" />
								))}
								{desktopOutputs.map((output) => (
									<g class="ad-a431-output__box-group" data-belongs={output.id}>
										<rect class="ad-a431-output__box" x={OUTPUT_X} y={output.cy - OUTPUT_H / 2} width={OUTPUT_W} height={OUTPUT_H} rx="10" />
										<circle class="ad-a431-port ad-a431-port--output" data-belongs={output.id} cx={OUTPUT_X} cy={output.cy} r="4" />
										<text class="ad-a431-label ad-a431-label--output" data-belongs={output.id} x={OUTPUT_X + 22} y={output.cy + 4}>{output.label}</text>
										<circle class="ad-a431-output__status" data-belongs={output.id} cx={OUTPUT_X + OUTPUT_W - 20} cy={output.cy} r="4.5" />
									</g>
								))}
							</svg>

							<!-- Mobile: separately composed, vertical flow — 2 inputs → FOLYAMAT
							     → 2 outputs, same refined grammar at a narrower scale. -->
							<svg
								class="ad-a431-system__svg ad-a431-system__svg--mobile"
								viewBox="0 0 380 460"
								role="img"
								aria-label="Élő rendszertérkép: Excel és külön rendszer egy közös FOLYAMAT csomóponton keresztül két rendezett kimenetté, jóváhagyássá és számlázássá alakulnak. Minden bemenet és mindkét kimenet a diagram alatti vezérlőkkel kiemelhető."
							>
								<line class="ad-a431-guideline" x1="190" y1="10" x2="190" y2="450" />
								<path class="ad-a431-tick" d="M180,230 L200,230 M190,220 L190,240" />

								<circle class="ad-a431-ring ad-a431-ring--fill1" cx="190" cy="230" r="100" />
								<circle class="ad-a431-ring ad-a431-ring--fill2" cx="190" cy="230" r="84" />
								<circle class="ad-a431-ring ad-a431-ring--fill3" cx="190" cy="230" r="68" />
								<circle class="ad-a431-ring ad-a431-ring--fill4" cx="190" cy="230" r="53" />
								<circle class="ad-a431-ring ad-a431-ring--stroke1" cx="190" cy="230" r="90" />
								<circle class="ad-a431-ring ad-a431-ring--stroke2" cx="190" cy="230" r="74" />

								<path class="ad-a431-line ad-a431-line--critical" data-belongs="excel" d="M185,64 C185,140 190,160 190,180" marker-end="url(#a431-arrow-accent)" />
								<path class="ad-a431-line" data-belongs="kulon" d="M370,64 C370,140 220,160 190,180" marker-end="url(#a431-arrow-neutral)" />

								<g class="ad-a431-input__box-group" data-belongs="excel">
									<rect class="ad-a431-input__box ad-a431-input__box--critical" x="10" y="40" width="175" height="48" rx="8" />
									<use href="#a431-icon-table" class="ad-a431-input__icon" data-belongs="excel" x="26" y="56" width="16" height="16" />
									<text class="ad-a431-label" data-belongs="excel" x="52" y="68">EXCEL</text>
									<circle class="ad-a431-port" data-belongs="excel" cx="185" cy="64" r="4" />
								</g>
								<g class="ad-a431-input__box-group" data-belongs="kulon">
									<rect class="ad-a431-input__box" x="195" y="40" width="175" height="48" rx="8" />
									<use href="#a431-icon-system" class="ad-a431-input__icon" data-belongs="kulon" x="211" y="56" width="16" height="16" />
									<text class="ad-a431-label" data-belongs="kulon" x="237" y="68">KÜLÖN RENDSZER</text>
									<circle class="ad-a431-port" data-belongs="kulon" cx="370" cy="64" r="4" />
								</g>

								<rect class="ad-a431-core-shell" x="90" y="180" width="200" height="100" rx="16" />
								<rect class="ad-a431-core-inner" x="115" y="205" width="150" height="50" rx="10" />
								<text class="ad-a431-core-label" x="140" y="235">FOLYAMAT</text>
								<use href="#a431-icon-core" class="ad-a431-core-icon" x="225" y="222" width="16" height="16" />

								<path class="ad-a431-line ad-a431-line--resolved" data-belongs="jovahagyas" d="M190,280 C190,310 130,325 95,340" marker-start="url(#a431-arrow-accent)" />
								<path class="ad-a431-line ad-a431-line--resolved" data-belongs="szamlazas" d="M190,280 C190,310 250,325 285,340" marker-start="url(#a431-arrow-accent)" />

								<g class="ad-a431-output__box-group" data-belongs="jovahagyas">
									<rect class="ad-a431-output__box" x="20" y="340" width="150" height="54" rx="10" />
									<circle class="ad-a431-port ad-a431-port--output" data-belongs="jovahagyas" cx="95" cy="340" r="4" />
									<text class="ad-a431-label ad-a431-label--output" data-belongs="jovahagyas" x="40" y="372">JÓVÁHAGYÁS</text>
									<circle class="ad-a431-output__status" data-belongs="jovahagyas" cx="150" cy="367" r="4.5" />
								</g>
								<g class="ad-a431-output__box-group" data-belongs="szamlazas">
									<rect class="ad-a431-output__box" x="210" y="340" width="150" height="54" rx="10" />
									<circle class="ad-a431-port ad-a431-port--output" data-belongs="szamlazas" cx="285" cy="340" r="4" />
									<text class="ad-a431-label ad-a431-label--output" data-belongs="szamlazas" x="230" y="372">SZÁMLÁZÁS</text>
									<circle class="ad-a431-output__status" data-belongs="szamlazas" cx="340" cy="367" r="4.5" />
								</g>
							</svg>

							<!-- Interactive overlay controls — real <button> elements,
							     percentage-sized against each container's exact viewBox rect
							     (centre-point convention: translate(-50%,-50%) on the button). -->
							<button type="button" class="ad-a431-node-btn ad-a431-node-btn--desktop" data-node="excel" style="left: 13.520%; top: 25.143%; width: 22.959%; height: 6.857%;" aria-pressed="false" aria-label="EXCEL bemenet kiemelése"></button>
							<button type="button" class="ad-a431-node-btn ad-a431-node-btn--desktop" data-node="email" style="left: 13.520%; top: 36.857%; width: 22.959%; height: 6.857%;" aria-pressed="false" aria-label="E-MAIL bemenet kiemelése"></button>
							<button type="button" class="ad-a431-node-btn ad-a431-node-btn--desktop" data-node="kulon" style="left: 13.520%; top: 48.571%; width: 22.959%; height: 6.857%;" aria-pressed="false" aria-label="KÜLÖN RENDSZER bemenet kiemelése"></button>
							<button type="button" class="ad-a431-node-btn ad-a431-node-btn--desktop" data-node="kezi" style="left: 13.520%; top: 60.286%; width: 22.959%; height: 6.857%;" aria-pressed="false" aria-label="KÉZI ADAT bemenet kiemelése"></button>
							<button type="button" class="ad-a431-node-btn ad-a431-node-btn--desktop" data-node="api" style="left: 13.520%; top: 72%; width: 22.959%; height: 6.857%;" aria-pressed="false" aria-label="API bemenet kiemelése"></button>
							<button type="button" class="ad-a431-node-btn ad-a431-node-btn--desktop" data-node="jovahagyas" style="left: 87.755%; top: 38.571%; width: 20.408%; height: 9.429%;" aria-pressed="false" aria-label="JÓVÁHAGYÁS kimenet kiemelése"></button>
							<button type="button" class="ad-a431-node-btn ad-a431-node-btn--desktop" data-node="szamlazas" style="left: 87.755%; top: 58.571%; width: 20.408%; height: 9.429%;" aria-pressed="false" aria-label="SZÁMLÁZÁS kimenet kiemelése"></button>

							<button type="button" class="ad-a431-node-btn ad-a431-node-btn--mobile" data-node="excel" style="left: 25.658%; top: 13.913%; width: 46.053%; height: 10.435%;" aria-pressed="false" aria-label="EXCEL bemenet kiemelése"></button>
							<button type="button" class="ad-a431-node-btn ad-a431-node-btn--mobile" data-node="kulon" style="left: 74.342%; top: 13.913%; width: 46.053%; height: 10.435%;" aria-pressed="false" aria-label="KÜLÖN RENDSZER bemenet kiemelése"></button>
							<button type="button" class="ad-a431-node-btn ad-a431-node-btn--mobile" data-node="jovahagyas" style="left: 25%; top: 79.783%; width: 39.474%; height: 11.739%;" aria-pressed="false" aria-label="JÓVÁHAGYÁS kimenet kiemelése"></button>
							<button type="button" class="ad-a431-node-btn ad-a431-node-btn--mobile" data-node="szamlazas" style="left: 75%; top: 79.783%; width: 39.474%; height: 11.739%;" aria-pressed="false" aria-label="SZÁMLÁZÁS kimenet kiemelése"></button>
							</div>

							<div class="ad-a431-annotation">
								<div class="ad-a431-legend">
									<span class="ad-a431-legend__item">
										<svg class="ad-a431-legend__swatch" width="26" height="6" viewBox="0 0 26 6" aria-hidden="true"><line x1="1" y1="3" x2="25" y2="3" class="ad-a431-legend__stroke ad-a431-legend__stroke--primary" /></svg>
										PRIMER ÚTVONAL
									</span>
									<span class="ad-a431-legend__item">
										<svg class="ad-a431-legend__swatch" width="26" height="6" viewBox="0 0 26 6" aria-hidden="true"><line x1="1" y1="3" x2="25" y2="3" class="ad-a431-legend__stroke ad-a431-legend__stroke--secondary" /></svg>
										SZEKUNDER ÚTVONAL
									</span>
									<span class="ad-a431-legend__item">
