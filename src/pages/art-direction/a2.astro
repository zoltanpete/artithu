---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/layout/Container.astro';
import SiteHeader from '../../components/navigation/SiteHeader.astro';
import ExperimentalBanner from '../../components/experimental/ExperimentalBanner.astro';
---

<BaseLayout
	title="Art Direction A2 — Contemporary Editorial Engineering (kísérleti, dev-only)"
	description="Kísérleti art-direction iteráció az A irányra építve — nem publikus, nem végleges."
	noindex={true}
>
	<ExperimentalBanner label="ART DIRECTION A2 — CONTEMPORARY EDITORIAL ENGINEERING" />
	<SiteHeader />

	<main class="ad-a2">
		<!-- Hero -->
		<section class="ad-a2-hero">
			<Container width="wide" as="div">
				<div class="ad-a2-hero__grid">
					<div class="ad-a2-hero__main">
						<p class="ad-a2-flowline">FOLYAMAT → ALKALMAZÁS → INTEGRÁCIÓ → ADAT</p>
						<p class="eyebrow" style="margin-block-start: var(--space-md);">
							Amikor a kész szoftver már nem elég.
						</p>
						<h1 style="margin-block-start: var(--space-sm);">
							A szoftver alkalmazkodjon a vállalkozásához. Ne fordítva.
						</h1>
						<p class="lead" style="max-width: var(--content-reading); margin-block-start: var(--space-lg);">
							Egyedi webes üzleti alkalmazásokat tervezünk és fejlesztünk olyan
							vállalkozásoknak, amelyek működése már túl speciális az Excelhez vagy
							egy kompromisszumos kész rendszerhez.
						</p>
						<div class="meta-row" style="margin-block-start: var(--space-xl);">
							<a href="/kapcsolat/" class="btn btn-primary">Beszéljünk a projektről →</a>
							<a href="/munkaink/" class="link-standalone">Munkáink megtekintése</a>
						</div>
					</div>

					<div class="ad-a2-evidence">
						<div class="ad-a2-evidence__panel">
							<p class="ad-a2-evidence__caption">VALÓS SZOFTVER RÉSZLET — HELYŐRZŐ</p>
						</div>
						<p class="ad-a2-evidence__tag">RÉSZLET / 01</p>
					</div>
				</div>
			</Container>
		</section>

		<hr class="divider ad-a2-divider" />

		<!-- Problem / Recognition -->
		<section class="section ad-a2-problem">
			<Container width="wide" as="div">
				<div class="ad-a2-problem__intro">
					<p class="eyebrow">Ismerős helyzet?</p>
					<h2 style="margin-block-start: var(--space-sm); max-width: var(--content-reading);">
						A legtöbb egyedi rendszer nem azzal kezdődik, hogy „egyedi szoftvert
						szeretnénk”.
					</h2>
				</div>

				<ol class="ad-a2-spine">
					<li>
						<span class="meta">TÜNET / 01</span>
						<p>„Ezt Excelben vezetjük.”</p>
					</li>
					<li>
						<span class="meta">TÜNET / 02</span>
						<p>„Innen kézzel átmásoljuk oda.”</p>
					</li>
					<li>
						<span class="meta">TÜNET / 03</span>
						<p>„Erre van egy külön rendszerünk.”</p>
					</li>
					<li>
						<span class="meta">TÜNET / 04</span>
						<p>„Ezt csak egy ember tudja, hogyan működik.”</p>
					</li>
					<li>
						<span class="meta">TÜNET / 05</span>
						<p>„Megnéztünk több kész rendszert, de egyik sem kezeli jól a
						folyamatunkat.”</p>
					</li>
					<li>
						<span class="meta">TÜNET / 06</span>
						<p>„A rendszereink működnek, csak éppen nem kommunikálnak egymással.”</p>
					</li>
				</ol>

				<p style="max-width: var(--content-reading); margin-block-start: var(--space-xl);">
					Ezek önmagukban még nem jelentik azt, hogy egyedi szoftverre van szükség.
					Azt viszont gyakran jelzik, hogy a vállalkozás működése és az azt támogató
					eszközök már nincsenek összhangban.
				</p>

				<a
					href="/egyedi-fejlesztes/"
					class="link-standalone"
					style="margin-block-start: var(--space-lg);"
				>
					Mikor érdemes egyedi fejlesztésben gondolkodni? →
				</a>
			</Container>
		</section>

		<hr class="divider" />

		<!-- Decision — transition preview only -->
		<section class="section">
			<Container width="standard">
				<h2 style="max-width: var(--content-reading);">
					Nem minden problémára kell egyedi szoftver.
				</h2>
				<p class="lead" style="max-width: var(--content-reading); margin-block-start: var(--space-sm);">
					Amire viszont igen, arra pontosan illeszkedőt építünk.
				</p>
			</Container>
		</section>
	</main>
</BaseLayout>

<style>
	/*
	 * A2 — experimental, provisional values only:
	 * --ad-a2-tint is derived by mixing 8% of the locked --color-accent into
	 * --color-bg (#e6e9e6). Contrast verified: body text on tint 14.2:1 (AAA),
	 * accent text on tint 6.2:1 (AA). Not a new design-system token.
	 */
	.ad-a2 {
		--ad-a2-tint: #e6e9e6;
	}

	.ad-a2-hero {
		padding-block-start: var(--space-section-lg);
		padding-block-end: var(--space-2xl);
	}

	.ad-a2-flowline {
		margin: 0;
		font-family: var(--font-mono);
		font-size: var(--text-meta);
		letter-spacing: var(--tracking-wide);
		color: var(--color-text-muted);
	}

	.ad-a2-hero__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-xl);
		align-items: start;
	}

	.ad-a2-evidence {
		position: relative;
	}

	.ad-a2-evidence__panel {
		aspect-ratio: 3 / 4;
		border: 1px solid var(--color-border);
		background: var(--ad-a2-tint);
		display: flex;
		align-items: flex-end;
		padding: var(--space-lg);
	}

	.ad-a2-evidence__caption {
		margin: 0;
		font-family: var(--font-mono);
		font-size: var(--text-meta);
		letter-spacing: var(--tracking-wide);
		color: var(--color-text-muted);
		max-width: 14rem;
	}

	.ad-a2-evidence__tag {
		display: inline-block;
		margin-block-start: var(--space-sm);
		padding: var(--space-xs) var(--space-sm);
		background: var(--color-accent-strong);
		color: #ffffff;
		font-family: var(--font-mono);
		font-size: var(--text-meta);
		letter-spacing: var(--tracking-wide);
	}

	.ad-a2-divider {
		position: relative;
	}

	.ad-a2-problem {
		padding-block-start: var(--space-xl);
	}

	.ad-a2-problem__intro {
		max-width: var(--content-reading);
	}

	.ad-a2-spine {
		list-style: none;
		margin: var(--space-xl) 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr;
	}

	.ad-a2-spine li {
		position: relative;
		padding-inline-start: var(--space-lg);
		padding-block: var(--space-md);
		border-left: 2px solid var(--color-border);
	}

	.ad-a2-spine li:nth-child(odd) {
		background: var(--ad-a2-tint);
	}

	.ad-a2-spine li::before {
		content: '';
		position: absolute;
		left: -5px;
		top: calc(var(--space-md) + 0.4em);
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--color-accent);
	}

	.ad-a2-spine li .meta {
		display: block;
		margin-block-end: var(--space-xs);
	}

	.ad-a2-spine li p {
		font-size: var(--text-lead);
		font-weight: 500;
		line-height: var(--leading-snug);
	}

	@media (min-width: 900px) {
		.ad-a2-hero__grid {
			grid-template-columns: 6fr 5fr;
			gap: var(--space-2xl);
		}

		.ad-a2-evidence {
			margin-block-start: var(--space-2xl);
			/* Bounded to the container's own inline padding so the bleed can
			   never exceed the container's outer edge, regardless of viewport
			   width — this stays safe even where content-wide's max-width
			   equals the viewport exactly (e.g. 1440px) and no auto-margin
			   slack exists to absorb a larger negative margin. */
			margin-inline-end: calc(-1 * var(--space-lg));
			margin-block-end: calc(-1 * var(--space-2xl));
		}

		.ad-a2-evidence__panel {
			aspect-ratio: 4 / 5;
		}

		.ad-a2-problem__intro {
			margin-inline-start: 32%;
		}

		.ad-a2-spine {
			grid-template-columns: 1fr 1fr;
			column-gap: var(--space-2xl);
		}
	}
</style>
