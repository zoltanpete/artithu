---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/layout/Container.astro';
import SiteHeader from '../../components/navigation/SiteHeader.astro';
import ExperimentalBanner from '../../components/experimental/ExperimentalBanner.astro';

// Task 010A exploration, round 2 — the first pass (still visible in git
// history / the completion report) surfaced real problems in all three
// initial sketches: ascending bars read as an invented growth chart, a
// pulse+"AKTÍV" label duplicated the exact "RENDSZER / AKTÍV" live-status
// badge DOC/07 already documents as rejected during the A4.3 exploration,
// and a core+concentric-rings treatment sat too close to OperatingFitField's
// own silhouette. Two concepts revised to remove those specific risks,
// compared again for real rather than assumed fixed.
---

<BaseLayout title="Task 010A — Munkáink Brand-Face Concepts, round 2" description="Exploration prototype" noindex={true}>
	<SiteHeader />
	<ExperimentalBanner label="TASK 010A — ROUND 2 — CONCEPTS A' / C' — KÍSÉRLETI NÉZET, NEM VÉGLEGES" />

	<main>
		<!-- Concept A' — Operational Record Index (uniform, no growth implication) -->
		<section class="section section--major">
			<Container width="standard">
				<div class="grid">
					<div>
						<p class="eyebrow">Concept A' — Operational Record Index</p>
						<h2 style="margin-block-start: var(--space-sm);">Egyenletes súlyú jelek — nem növekvő diagram, csak felhalmozott állapotok.</h2>
						<p style="margin-block-start: var(--space-md); max-width: var(--content-reading);">Bizonyíték, nem bemutató.</p>
					</div>
					<div class="stack-vis">
						<svg viewBox="0 0 260 260" role="img" aria-label="Felhalmozott, egyenlő súlyú működési állapotjelek egy folyamatosan élő rendszer jeleként">
							<line x1="60" y1="20" x2="60" y2="230" stroke="var(--color-accent)" stroke-width="1.25" opacity="0.5" />
							{[0.9, 0.4, 0.7, 0.55, 0.85, 0.45, 0.75].map((op, i) => {
								const y = 24 + i * 30;
								return (
									<>
										<circle cx="60" cy={y} r="3.5" fill="var(--color-accent)" opacity={op} />
										<rect x="76" y={y - 6} width="150" height="12" rx="2" fill="var(--color-accent)" opacity={(op * 0.35).toFixed(2)} />
									</>
								);
							})}
						</svg>
					</div>
				</div>
			</Container>
		</section>

		<hr class="divider" />

		<!-- Concept C' — Ambient Operating Field (core + sparse field, no rings, no satellites) -->
		<section class="section section--major">
			<Container width="standard">
				<div class="grid">
					<div>
						<p class="eyebrow">Concept C' — Ambient Operating Field</p>
						<h2 style="margin-block-start: var(--space-sm);">A rendszer nem elszigetelt — a működés terében létezik, gyűrűk és jelölt kapcsolatok nélkül.</h2>
						<p style="margin-block-start: var(--space-md); max-width: var(--content-reading);">Bizonyíték, nem bemutató.</p>
					</div>
					<div class="stack-vis">
						<svg viewBox="0 0 260 260" role="img" aria-label="Egy rendszer, amely folyamatosan a vállalkozás működési terében létezik">
							{Array.from({ length: 22 }).map((_, i) => {
								const angle = (i / 22) * Math.PI * 2 + (i % 2) * 0.15;
								const r = 45 + ((i * 37) % 60);
								const x = 130 + Math.cos(angle) * r;
								const y = 130 + Math.sin(angle) * r;
								const op = 0.25 + ((i * 13) % 10) / 20;
								return <circle cx={x} cy={y} r={1.5 + (i % 3) * 0.5} fill="var(--color-text-muted)" opacity={op.toFixed(2)} />;
							})}
							<circle cx="130" cy="130" r="22" fill="var(--color-bg)" stroke="var(--color-accent)" stroke-width="1.5" />
							<circle cx="130" cy="130" r="3" fill="var(--color-accent)" />
							<text x="130" y="165" text-anchor="middle" font-family="var(--font-mono)" font-size="10" letter-spacing="0.06em" fill="var(--color-text)">RENDSZER</text>
						</svg>
					</div>
				</div>
			</Container>
		</section>
	</main>
</BaseLayout>

<style>
	.grid { display: grid; grid-template-columns: 1fr; gap: var(--space-xl); }
	@media (min-width: 900px) { .grid { grid-template-columns: 3fr 2fr; align-items: center; } }
	.stack-vis svg { width: 100%; height: auto; max-width: 320px; margin-inline: auto; display: block; }
</style>
