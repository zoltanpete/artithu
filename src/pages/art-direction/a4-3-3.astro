---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/layout/Container.astro';
import SiteHeader from '../../components/navigation/SiteHeader.astro';
import ExperimentalBanner from '../../components/experimental/ExperimentalBanner.astro';

// Desktop graph geometry (viewBox 0 0 970 600) — same left→right narrative
// as A4.3.2, with the owner's A4.3.3 final-polish overrides applied: the
// inner core widened ~6% (INNER_W 190→202, height unchanged) and the
// outputs pulled 15px further from the shell (OUTPUT_X 740→755) for
// slightly longer, more elegant resolving arcs.
const INPUT_X = 20;
const INPUT_W = 225;
const INPUT_H = 44;
const INPUT_GAP = 20;
const INPUT_START_Y = 158;

const desktopInputs = [
	{ id: 'excel', label: 'EXCEL', icon: 'table', critical: true },
	{ id: 'email', label: 'E-MAIL', icon: 'mail' },
	{ id: 'kulon', label: 'KÜLÖN RENDSZER', icon: 'system' },
	{ id: 'kezi', label: 'KÉZI ADAT', icon: 'manual' },
	{ id: 'api', label: 'API', icon: 'api' },
	{ id: 'other', label: '…ÉS MINDEN MÁS FORRÁS', icon: 'dots', quiet: true },
].map((input, i) => ({ ...input, y: INPUT_START_Y + i * (INPUT_H + INPUT_GAP) }));

const CORE_CX = 560;
const CORE_CY = 340;
const SHELL_W = 240;
const SHELL_H = 110;
const SHELL_X = CORE_CX - SHELL_W / 2;
const SHELL_Y = CORE_CY - SHELL_H / 2;
const CORE_ENTRY_X = SHELL_X;
const CORE_EXIT_X = SHELL_X + SHELL_W;
const INNER_W = 202;
const INNER_H = 58;
const INNER_X = CORE_CX - INNER_W / 2;
const INNER_Y = CORE_CY - INNER_H / 2;

const OUTPUT_X = 755;
const OUTPUT_W = 200;
const OUTPUT_H = 64;

const desktopOutputs = [
	{ id: 'jovahagyas', label: 'JÓVÁHAGYÁS', icon: 'check', cy: CORE_CY - 65 },
	{ id: 'szamlazas', label: 'SZÁMLÁZÁS', icon: 'document', cy: CORE_CY + 65 },
];

function inputPath(startY: number) {
	return `M${INPUT_X + INPUT_W},${startY} C${INPUT_X + INPUT_W + 95},${startY} ${CORE_ENTRY_X - 48},${CORE_CY} ${CORE_ENTRY_X},${CORE_CY}`;
}

function outputPath(endCy: number) {
	const midY = CORE_CY + (endCy - CORE_CY) * 0.62;
	return `M${CORE_EXIT_X},${CORE_CY} C${CORE_EXIT_X + 40},${CORE_CY} ${OUTPUT_X - 24},${midY} ${OUTPUT_X},${endCy}`;
}
---

<BaseLayout
	title="Art Direction A4.3.3 — System Map Visual Refinement II (kísérleti, dev-only)"
	description="Kísérleti art-direction irány — nem publikus, nem végleges."
	noindex={true}
>
	<ExperimentalBanner label="ART DIRECTION A4.3.3 — SYSTEM MAP REFINEMENT II" />

	<div class="ad-a433">
		<SiteHeader />

		<main>
			<!-- Hero -->
			<section class="ad-a433-hero">
				<Container width="wide" as="div">
					<div class="ad-a433-hero__grid">
						<div class="ad-a433-hero__main">
							<p class="eyebrow">Amikor a kész szoftver már nem elég.</p>
							<h1 class="ad-a433-hero__h1">
								A szoftver alkalmazkodjon a vállalkozásához.<br />Ne fordítva.
							</h1>
							<p class="lead ad-a433-hero__lead" style="max-width: var(--content-reading);">
								Egyedi webes üzleti alkalmazásokat tervezünk és fejlesztünk olyan
								vállalkozásoknak, amelyek működése már túl speciális az Excelhez
								vagy egy kompromisszumos kész rendszerhez.
							</p>
							<div class="meta-row ad-a433-hero__cta">
								<a href="/kapcsolat/" class="btn btn-primary">Beszéljünk a projektről →</a>
								<a href="/munkaink/" class="link-standalone">Munkáink megtekintése</a>
							</div>
						</div>

						<div class="ad-a433-system" id="ad-a433-system">
							<div class="ad-a433-system__stage">
							<svg width="0" height="0" style="position:absolute;">
								<defs>
									<symbol id="a433-icon-table" viewBox="0 0 16 16">
										<rect x="1" y="1" width="14" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.3" />
										<line x1="1" y1="6.5" x2="15" y2="6.5" stroke="currentColor" stroke-width="1.1" />
										<line x1="1" y1="11" x2="15" y2="11" stroke="currentColor" stroke-width="1.1" />
										<line x1="8" y1="1" x2="8" y2="15" stroke="currentColor" stroke-width="1.1" />
										<rect x="9" y="7.3" width="5.2" height="3.4" class="ad-a433-icon-accent" />
									</symbol>
									<symbol id="a433-icon-mail" viewBox="0 0 16 16">
										<rect x="1" y="3" width="14" height="10" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.3" />
										<path d="M1.5,4 L8,9.5 L14.5,4" fill="none" stroke="currentColor" stroke-width="1.3" />
									</symbol>
									<symbol id="a433-icon-system" viewBox="0 0 16 16">
										<rect x="1" y="5" width="9" height="5.4" rx="2.7" fill="none" stroke="currentColor" stroke-width="1.3" />
										<rect x="6.5" y="5.6" width="9" height="5.4" rx="2.7" fill="none" stroke="currentColor" stroke-width="1.3" />
									</symbol>
									<symbol id="a433-icon-manual" viewBox="0 0 16 16">
										<path d="M4,1.5 L4,12.5 L6.6,10 L8.3,13.8 L10.1,13 L8.4,9.1 L11.4,8.9 Z" fill="currentColor" stroke="none" />
									</symbol>
									<symbol id="a433-icon-api" viewBox="0 0 16 16">
										<path d="M5.6,2.5 L1.6,8 L5.6,13.5" fill="none" stroke="currentColor" stroke-width="1.3" />
										<path d="M10.4,2.5 L14.4,8 L10.4,13.5" fill="none" stroke="currentColor" stroke-width="1.3" />
									</symbol>
									<symbol id="a433-icon-dots" viewBox="0 0 16 16">
										<circle cx="3" cy="8" r="1.3" fill="currentColor" />
										<circle cx="8" cy="8" r="1.3" fill="currentColor" />
										<circle cx="13" cy="8" r="1.3" fill="currentColor" />
									</symbol>
									<symbol id="a433-icon-check" viewBox="0 0 16 16">
										<circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.3" />
										<path d="M5,8.2 L7.2,10.4 L11,6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
									</symbol>
									<symbol id="a433-icon-document" viewBox="0 0 16 16">
										<path d="M3.5,1.5 L9.5,1.5 L12.5,4.5 L12.5,14.5 L3.5,14.5 Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
										<path d="M9.5,1.5 L9.5,4.5 L12.5,4.5" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round" />
										<line x1="5.5" y1="8" x2="10.5" y2="8" stroke="currentColor" stroke-width="1" />
										<line x1="5.5" y1="10.5" x2="10.5" y2="10.5" stroke="currentColor" stroke-width="1" />
									</symbol>
									<symbol id="a433-icon-core" viewBox="0 0 16 16">
										<circle cx="8" cy="8" r="5.4" fill="none" stroke="currentColor" stroke-width="1.3" />
										<circle cx="8" cy="8" r="1.7" fill="currentColor" stroke="none" />
									</symbol>

									<marker id="a433-arrow-accent" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
										<path d="M0,0 L10,5 L0,10 Z" class="ad-a433-arrow-fill ad-a433-arrow-fill--accent" />
									</marker>
									<marker id="a433-arrow-neutral" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5.5" markerHeight="5.5" orient="auto-start-reverse">
										<path d="M0,0 L10,5 L0,10 Z" class="ad-a433-arrow-fill ad-a433-arrow-fill--neutral" />
									</marker>
								</defs>
							</svg>

							<svg
								class="ad-a433-system__svg ad-a433-system__svg--desktop"
								viewBox="0 0 970 600"
								role="img"
								aria-label="Élő rendszertérkép: Excel, e-mail, külön rendszer, kézi adat, API és egyéb szétszórt üzleti bemenetek egy közös FOLYAMAT csomóponton keresztül két rendezett kimenetté, jóváhagyássá és számlázássá alakulnak, balról jobbra haladó folyamatként. Minden bemenet és mindkét kimenet a diagram alatti vezérlőkkel kiemelhető."
							>
								<!-- Subliminal construction/coordinate layer — second-look detail. -->
								<line class="ad-a433-guideline" x1="10" y1={CORE_CY} x2="950" y2={CORE_CY} />
								<line class="ad-a433-guideline" x1={CORE_CX} y1="20" x2={CORE_CX} y2="580" />
								<path class="ad-a433-tick" d={`M${CORE_CX - 10},${CORE_CY} L${CORE_CX + 10},${CORE_CY} M${CORE_CX},${CORE_CY - 10} L${CORE_CX},${CORE_CY + 10}`} />
								<path class="ad-a433-tick ad-a433-tick--corner" d="M22,47 L38,47 M30,39 L30,55" />
								<path class="ad-a433-tick ad-a433-tick--corner" d="M932,47 L948,47 M940,39 L940,55" />
								<path class="ad-a433-tick ad-a433-tick--corner" d="M932,297 L948,297 M940,289 L940,305" />
								<path class="ad-a433-reg-mark" d={`M${SHELL_X - 14},${SHELL_Y} L${SHELL_X - 14},${SHELL_Y - 14} L${SHELL_X},${SHELL_Y - 14}`} />
								<path class="ad-a433-reg-mark" d={`M${CORE_EXIT_X + 14},${SHELL_Y + SHELL_H} L${CORE_EXIT_X + 14},${SHELL_Y + SHELL_H + 14} L${CORE_EXIT_X},${SHELL_Y + SHELL_H + 14}`} />
								<text class="ad-a433-coord" x="14" y="42">X / 01</text>
								<text class="ad-a433-coord" x="944" y="42" text-anchor="end">X / 02</text>
								<text class="ad-a433-coord" x={CORE_CX + 8} y="34">Y / 01</text>
								<text class="ad-a433-coord" x={CORE_CX + 8} y="572">Y / 02</text>

								<!-- Concentric violet rings behind FOLYAMAT — depth without glow. -->
								<circle class="ad-a433-ring ad-a433-ring--fill1" cx={CORE_CX} cy={CORE_CY} r="175" />
								<circle class="ad-a433-ring ad-a433-ring--fill2" cx={CORE_CX} cy={CORE_CY} r="145" />
								<circle class="ad-a433-ring ad-a433-ring--fill3" cx={CORE_CX} cy={CORE_CY} r="115" />
								<circle class="ad-a433-ring ad-a433-ring--fill4" cx={CORE_CX} cy={CORE_CY} r="90" />
								<circle class="ad-a433-ring ad-a433-ring--stroke1" cx={CORE_CX} cy={CORE_CY} r="158" />
								<circle class="ad-a433-ring ad-a433-ring--stroke2" cx={CORE_CX} cy={CORE_CY} r="128" />

								<!-- Input relationship paths (the quiet "other" source now shares
								     the exact same path function as its siblings — it IS the
								     diagram's live example of the legend's dashed "KIVÉTEL /
								     ALTERNATÍV" tier, not a separate device). -->
								{desktopInputs.map((input) => (
									<path
										class={`ad-a433-line${input.critical ? ' ad-a433-line--critical' : ''}${input.quiet ? ' ad-a433-line--quiet' : ''}`}
										data-belongs={input.id}
										d={inputPath(input.y + INPUT_H / 2)}
										marker-end={`url(#a433-arrow-${input.critical ? 'accent' : 'neutral'})`}
									/>
								))}

								<!-- FOLYAMAT — wide, low, tightly layered transformation node. -->
								<rect class="ad-a433-core-shell" x={SHELL_X} y={SHELL_Y} width={SHELL_W} height={SHELL_H} rx="16" />
								<rect class="ad-a433-core-inner" x={INNER_X} y={INNER_Y} width={INNER_W} height={INNER_H} rx="11" />
								<text class="ad-a433-core-label" x={CORE_CX - 51} y={CORE_CY + 5}>FOLYAMAT</text>
								<use href="#a433-icon-core" class="ad-a433-core-icon" x={CORE_CX + 34} y={CORE_CY - 8} width="16" height="16" />

								<!-- Input containers -->
								{desktopInputs.map((input) => (
									<g class={`ad-a433-input__box-group${input.quiet ? ' ad-a433-input__box-group--quiet' : ''}`} data-belongs={input.id}>
										<rect
											class={`ad-a433-input__box${input.critical ? ' ad-a433-input__box--critical' : ''}`}
											x={INPUT_X}
											y={input.y}
											width={INPUT_W}
											height={INPUT_H}
											rx="8"
										/>
										<rect class="ad-a433-icon-chip" x={INPUT_X + 8} y={input.y + INPUT_H / 2 - 13} width="26" height="26" rx="6" />
										<use
											href={`#a433-icon-${input.icon}`}
											class="ad-a433-input__icon"
											data-belongs={input.id}
											x={INPUT_X + 13}
											y={input.y + INPUT_H / 2 - 8}
											width="16"
											height="16"
										/>
										<text class={`ad-a433-label${input.quiet ? ' ad-a433-label--quiet' : ''}`} data-belongs={input.id} x={INPUT_X + 42} y={input.y + INPUT_H / 2 + 4}>{input.label}</text>
										<circle class="ad-a433-port" data-belongs={input.id} cx={INPUT_X + INPUT_W} cy={input.y + INPUT_H / 2} r="4" />
									</g>
								))}

								<!-- Output relationship paths + containers -->
								{desktopOutputs.map((output) => (
									<path class="ad-a433-line ad-a433-line--resolved" data-belongs={output.id} d={outputPath(output.cy)} marker-start="url(#a433-arrow-accent)" />
								))}
								{desktopOutputs.map((output) => (
									<g class="ad-a433-output__box-group" data-belongs={output.id}>
										<rect class="ad-a433-output__box" x={OUTPUT_X} y={output.cy - OUTPUT_H / 2} width={OUTPUT_W} height={OUTPUT_H} rx="10" />
										<circle class="ad-a433-port ad-a433-port--output" data-belongs={output.id} cx={OUTPUT_X} cy={output.cy} r="4" />
										<rect class="ad-a433-icon-chip" x={OUTPUT_X + 14} y={output.cy - 13} width="26" height="26" rx="6" />
										<use href={`#a433-icon-${output.icon}`} class="ad-a433-output__icon" data-belongs={output.id} x={OUTPUT_X + 19} y={output.cy - 8} width="16" height="16" />
										<text class="ad-a433-label ad-a433-label--output" data-belongs={output.id} x={OUTPUT_X + 48} y={output.cy + 4}>{output.label}</text>
										<circle class="ad-a433-output__status" data-belongs={output.id} cx={OUTPUT_X + OUTPUT_W - 20} cy={output.cy} r="4.5" />
									</g>
								))}
							</svg>

							<!-- Mobile: separately composed, vertical flow — 2 inputs → FOLYAMAT
							     → 2 outputs, per A4.3.1's proven approach; construction guides
							     simplified further (single centre tick, no corner marks/coord
							     labels — clutter at 390px, not "second-look detail"). -->
							<svg
								class="ad-a433-system__svg ad-a433-system__svg--mobile"
								viewBox="0 0 380 420"
								role="img"
								aria-label="Élő rendszertérkép: Excel és külön rendszer egy közös FOLYAMAT csomóponton keresztül két rendezett kimenetté, jóváhagyássá és számlázássá alakulnak. Minden bemenet és mindkét kimenet a diagram alatti vezérlőkkel kiemelhető."
							>
								<line class="ad-a433-guideline" x1="190" y1="10" x2="190" y2="410" />
								<path class="ad-a433-tick" d="M180,230 L200,230 M190,220 L190,240" />

								<circle class="ad-a433-ring ad-a433-ring--fill1" cx="190" cy="230" r="88" />
								<circle class="ad-a433-ring ad-a433-ring--fill2" cx="190" cy="230" r="74" />
								<circle class="ad-a433-ring ad-a433-ring--fill3" cx="190" cy="230" r="60" />
								<circle class="ad-a433-ring ad-a433-ring--fill4" cx="190" cy="230" r="47" />
								<circle class="ad-a433-ring ad-a433-ring--stroke1" cx="190" cy="230" r="80" />
								<circle class="ad-a433-ring ad-a433-ring--stroke2" cx="190" cy="230" r="66" />

								<path class="ad-a433-line ad-a433-line--critical" data-belongs="excel" d="M185,64 C185,140 190,166 190,186" marker-end="url(#a433-arrow-accent)" />
								<path class="ad-a433-line" data-belongs="kulon" d="M370,64 C370,140 220,166 190,186" marker-end="url(#a433-arrow-neutral)" />

								<g class="ad-a433-input__box-group" data-belongs="excel">
									<rect class="ad-a433-input__box ad-a433-input__box--critical" x="10" y="40" width="175" height="48" rx="8" />
									<rect class="ad-a433-icon-chip" x="18" y="51" width="26" height="26" rx="6" />
									<use href="#a433-icon-table" class="ad-a433-input__icon" data-belongs="excel" x="23" y="56" width="16" height="16" />
									<text class="ad-a433-label" data-belongs="excel" x="52" y="68">EXCEL</text>
									<circle class="ad-a433-port" data-belongs="excel" cx="185" cy="64" r="4" />
								</g>
								<g class="ad-a433-input__box-group" data-belongs="kulon">
									<rect class="ad-a433-input__box" x="195" y="40" width="175" height="48" rx="8" />
									<rect class="ad-a433-icon-chip" x="203" y="51" width="26" height="26" rx="6" />
									<use href="#a433-icon-system" class="ad-a433-input__icon" data-belongs="kulon" x="208" y="56" width="16" height="16" />
									<text class="ad-a433-label" data-belongs="kulon" x="237" y="68">KÜLÖN RENDSZER</text>
									<circle class="ad-a433-port" data-belongs="kulon" cx="370" cy="64" r="4" />
								</g>

								<rect class="ad-a433-core-shell" x="105" y="186" width="170" height="88" rx="14" />
								<rect class="ad-a433-core-inner" x="120" y="207" width="140" height="46" rx="9" />
								<text class="ad-a433-core-label" x="139" y="235">FOLYAMAT</text>
								<use href="#a433-icon-core" class="ad-a433-core-icon" x="224" y="222" width="16" height="16" />

								<path class="ad-a433-line ad-a433-line--resolved" data-belongs="jovahagyas" d="M190,274 C190,300 130,315 95,330" marker-start="url(#a433-arrow-accent)" />
								<path class="ad-a433-line ad-a433-line--resolved" data-belongs="szamlazas" d="M190,274 C190,300 250,315 285,330" marker-start="url(#a433-arrow-accent)" />

								<g class="ad-a433-output__box-group" data-belongs="jovahagyas">
									<rect class="ad-a433-output__box" x="20" y="330" width="150" height="54" rx="10" />
									<circle class="ad-a433-port ad-a433-port--output" data-belongs="jovahagyas" cx="95" cy="330" r="4" />
									<rect class="ad-a433-icon-chip ad-a433-icon-chip--sm" x="30" y="344" width="22" height="22" rx="5" />
									<use href="#a433-icon-check" class="ad-a433-output__icon" data-belongs="jovahagyas" x="34" y="348" width="14" height="14" />
									<text class="ad-a433-label ad-a433-label--output" data-belongs="jovahagyas" x="58" y="360">JÓVÁHAGYÁS</text>
									<circle class="ad-a433-output__status" data-belongs="jovahagyas" cx="150" cy="357" r="4.5" />
								</g>
								<g class="ad-a433-output__box-group" data-belongs="szamlazas">
									<rect class="ad-a433-output__box" x="210" y="330" width="150" height="54" rx="10" />
									<circle class="ad-a433-port ad-a433-port--output" data-belongs="szamlazas" cx="285" cy="330" r="4" />
									<rect class="ad-a433-icon-chip ad-a433-icon-chip--sm" x="220" y="344" width="22" height="22" rx="5" />
									<use href="#a433-icon-document" class="ad-a433-output__icon" data-belongs="szamlazas" x="224" y="348" width="14" height="14" />
									<text class="ad-a433-label ad-a433-label--output" data-belongs="szamlazas" x="248" y="360">SZÁMLÁZÁS</text>
									<circle class="ad-a433-output__status" data-belongs="szamlazas" cx="340" cy="357" r="4.5" />
								</g>
							</svg>

							<!-- Interactive overlay controls — real <button> elements,
							     percentage-sized against each container's exact viewBox rect
							     (centre-point convention: translate(-50%,-50%) on the button).
							     The quiet "other" source stays non-interactive, as in A4.3.1. -->
							<button type="button" class="ad-a433-node-btn ad-a433-node-btn--desktop" data-node="excel" style="left: 13.660%; top: 30%; width: 23.196%; height: 7.333%;" aria-pressed="false" aria-label="EXCEL bemenet kiemelése"></button>
							<button type="button" class="ad-a433-node-btn ad-a433-node-btn--desktop" data-node="email" style="left: 13.660%; top: 40.667%; width: 23.196%; height: 7.333%;" aria-pressed="false" aria-label="E-MAIL bemenet kiemelése"></button>
							<button type="button" class="ad-a433-node-btn ad-a433-node-btn--desktop" data-node="kulon" style="left: 13.660%; top: 51.333%; width: 23.196%; height: 7.333%;" aria-pressed="false" aria-label="KÜLÖN RENDSZER bemenet kiemelése"></button>
							<button type="button" class="ad-a433-node-btn ad-a433-node-btn--desktop" data-node="kezi" style="left: 13.660%; top: 62%; width: 23.196%; height: 7.333%;" aria-pressed="false" aria-label="KÉZI ADAT bemenet kiemelése"></button>
