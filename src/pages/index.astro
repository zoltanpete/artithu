---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/layout/Container.astro';
import SiteHeader from '../components/navigation/SiteHeader.astro';
import SystemMap from '../components/system-map/SystemMap.astro';
import type { SystemMapSource, SystemMapOutput } from '../components/system-map/SystemMap.astro';

// Hero System Map data — the same source vocabulary as the Problem
// section's own approved quotes below, for narrative consistency between
// the two sections. See DOC/07 "System Map — ARTIT brand asset": this
// instance's exact labels/count are not themselves locked, only the grammar
// is; six sources reuses the visually-verified A4.3.3 reference geometry.
const heroSources: SystemMapSource[] = [
	{ id: 'excel', label: 'EXCEL', icon: 'table', route: 'primary' },
	{ id: 'email', label: 'E-MAIL', icon: 'mail' },
	{ id: 'kulon', label: 'KÜLÖN RENDSZER', icon: 'system' },
	{ id: 'kezi', label: 'KÉZI ADAT', icon: 'manual' },
	{ id: 'api', label: 'API', icon: 'api' },
	{ id: 'other', label: '…ÉS MINDEN MÁS FORRÁS', icon: 'dots', route: 'exception' },
];

const heroOutputs: [SystemMapOutput, SystemMapOutput] = [
	{ id: 'jovahagyas', label: 'JÓVÁHAGYÁS', icon: 'check' },
	{ id: 'szamlazas', label: 'SZÁMLÁZÁS', icon: 'document' },
];
---

<BaseLayout
	title="ARTIT — Egyedi üzleti szoftverfejlesztés senior tapasztalattal"
	description="Egyedi webes üzleti alkalmazásokat tervezünk és fejlesztünk olyan vállalkozásoknak, amelyek működése már túl speciális az Excelhez vagy egy kompromisszumos kész rendszerhez."
	path="/"
>
	<SiteHeader />

	<main>
		<!-- 01 — Hero -->
		<section class="hero-map">
			<Container width="wide" as="div">
				<div class="hero-map__grid">
					<div class="hero-map__main">
						<p class="eyebrow">Amikor a kész szoftver már nem elég.</p>
						<h1 class="hero-map__h1">
							A szoftver alkalmazkodjon a vállalkozásához. Ne fordítva.
						</h1>
						<p class="lead hero-map__lead" style="max-width: var(--content-reading);">
							Egyedi webes üzleti alkalmazásokat tervezünk és fejlesztünk olyan
							vállalkozásoknak, amelyek működése már túl speciális az Excelhez vagy egy
							kompromisszumos kész rendszerhez.
						</p>
						<div class="meta-row hero-map__cta">
							<a href="/kapcsolat/" class="btn btn-primary">Beszéljünk a projektről →</a>
							<a href="/munkaink/" class="link-standalone">Munkáink megtekintése</a>
						</div>
					</div>

					<div class="hero-map__visual">
						<SystemMap
							id="hero-system-map"
							sources={heroSources}
							coreLabel="FOLYAMAT"
							outputs={heroOutputs}
							mobileSourceIds={['excel', 'kulon']}
							caption="BEMENETEK → FOLYAMAT → KIMENETEK"
							captionSub="TISZTA. KAPCSOLÓDÓ. ÁTLÁTHATÓ."
							ariaLabel="Élő rendszertérkép: Excel, e-mail, külön rendszer, kézi adat, API és egyéb szétszórt üzleti bemenetek egy közös FOLYAMAT csomóponton keresztül két rendezett kimenetté, jóváhagyássá és számlázássá alakulnak, balról jobbra haladó folyamatként. Minden bemenet és mindkét kimenet a diagram alatti vezérlőkkel kiemelhető."
						/>
					</div>
				</div>
			</Container>
		</section>

		<hr class="divider" />

		<!-- 02 — Problem / Recognition -->
		<section class="section">
			<Container width="standard">
				<p class="eyebrow">Ismerős helyzet?</p>
				<h2 style="margin-block-start: var(--space-sm); max-width: var(--content-reading);">
					A legtöbb egyedi rendszer nem azzal kezdődik, hogy „egyedi szoftvert
					szeretnénk”.
				</h2>

				<div class="problem-grid">
					<p class="problem-grid__statement">„Ezt Excelben vezetjük.”</p>
					<p class="problem-grid__statement">„Innen kézzel átmásoljuk oda.”</p>
					<p class="problem-grid__statement">„Erre van egy külön rendszerünk.”</p>
					<p class="problem-grid__statement">
						„Ezt csak egy ember tudja, hogyan működik.”
					</p>
					<p class="problem-grid__statement">
						„Megnéztünk több kész rendszert, de egyik sem kezeli jól a
						folyamatunkat.”
					</p>
					<p class="problem-grid__statement">
						„A rendszereink működnek, csak éppen nem kommunikálnak egymással.”
					</p>
				</div>

				<p style="max-width: var(--content-reading); margin-block-start: var(--space-xl);">
					Ezek önmagukban még nem jelentik azt, hogy egyedi szoftverre van szükség.
					Azt viszont gyakran jelzik, hogy a vállalkozás működése és az azt támogató
					eszközök már nincsenek összhangban.
				</p>

				<a
					href="/egyedi-fejlesztes/"
					class="link-standalone"
					style="margin-block-start: var(--space-lg);"
				>
					Mikor érdemes egyedi fejlesztésben gondolkodni? →
				</a>
			</Container>
		</section>

		<hr class="divider" />

		<!-- 03 — Decision / What ARTIT does -->
		<section class="section">
			<Container width="standard">
				<h2 style="max-width: var(--content-reading);">
					Nem minden problémára kell egyedi szoftver.
				</h2>
				<p class="lead" style="max-width: var(--content-reading); margin-block-start: var(--space-sm);">
					Amire viszont igen, arra pontosan illeszkedőt építünk.
				</p>
				<p style="max-width: var(--content-reading); margin-block-start: var(--space-lg);">
					Ha a jelenlegi kész szoftver jól támogatja a működést, nincs értelme
					újraépíteni. Előbb azt érdemes megérteni, hogyan működik ma a
					vállalkozás — utána dönthető el, milyen szoftverre van ténylegesen
					szükség.
				</p>

				<svg class="decision-fork" viewBox="0 0 120 56" aria-hidden="true">
					<path d="M60,2 L60,20" />
					<path d="M60,20 C60,32 22,30 22,42 L22,52" />
					<path d="M60,20 C60,32 98,30 98,42 L98,52" />
					<circle cx="60" cy="20" r="3" />
					<circle cx="22" cy="52" r="3" />
					<circle cx="98" cy="52" r="3" />
				</svg>

				<div class="decision-paths">
					<div class="decision-paths__path">
						<h3>Egyedi üzleti alkalmazások</h3>
						<p style="margin-block-start: var(--space-sm);">
							Ha a folyamat különleges, és a kész rendszerek kompromisszumra
							kényszerítik a működést.
						</p>
						<a
							href="/egyedi-fejlesztes/uzleti-alkalmazasok/"
							class="link-standalone"
							style="margin-block-start: var(--space-md);"
						>
							Egyedi üzleti alkalmazások →
						</a>
					</div>
					<div class="decision-paths__path">
						<h3>Rendszerintegráció és automatizáció</h3>
						<p style="margin-block-start: var(--space-sm);">
							Ha a rendszerek külön-külön már megvannak, csak éppen nem
							kommunikálnak egymással.
						</p>
						<a
							href="/egyedi-fejlesztes/rendszerintegracio/"
							class="link-standalone"
							style="margin-block-start: var(--space-md);"
						>
							Rendszerintegráció és automatizáció →
						</a>
					</div>
				</div>
			</Container>
		</section>

		<hr class="divider" />

		<!-- 04 — Work. Real case-study facts (customer names, exact years,
		     screenshots) are not publication-safe yet — see
		     DOC/13-CONTENT-GAPS-AND-VALIDATION.md — so this section shows only
		     the two documented working titles, with no invented specifics and
		     no placeholder screenshot standing in for evidence that doesn't
		     exist yet. Both link to /munkaink/ (the hub), not to a specific
		     case-study detail page, since none exists yet. -->
		<section class="section work-teaser">
			<Container width="standard">
				<p class="eyebrow">Valódi rendszerek. Valódi működésben.</p>
				<h2 style="margin-block-start: var(--space-sm); max-width: var(--content-reading);">
					Olyan szoftvereket építünk, amelyek hosszú távon a vállalkozás
					működésének részévé válnak.
				</h2>

				<ol class="work-teaser__list">
					<li class="work-teaser__item">
						<span class="meta">CASE / 01</span>
						<p class="work-teaser__title">
							Egy üzleti rendszer, amely együtt nőtt a vállalkozással.
						</p>
					</li>
					<li class="work-teaser__item">
						<span class="meta">CASE / 02</span>
						<p class="work-teaser__title">
							A rendszer, amely több ERP-t is túlélt.
						</p>
					</li>
				</ol>

				<a href="/munkaink/" class="link-standalone" style="margin-block-start: var(--space-lg);">
					Munkáink megtekintése →
				</a>
			</Container>
		</section>

		<hr class="divider" />

		<!-- 05 — Longevity. Exact durations/years are gated (TO VERIFY per
		     DOC/13); only the principle is published, per Task 007 §14's
		     explicit allowance to communicate the principle without
		     unsupported specifics. Dark section — the homepage's one
		     deliberate rhythm change, per DOC/07 "Dark sections: use rarely." -->
		<section class="section section--major section--dark">
			<Container width="standard">
				<h2 style="max-width: var(--content-reading);">
					A hosszú táv nálunk nem marketingígéret.
				</h2>
				<p class="lead" style="max-width: var(--content-reading); margin-block-start: var(--space-md);">
					A technológia eszköz. A működő rendszer a cél.
				</p>
			</Container>
		</section>

		<hr class="divider" />

		<!-- 06 — Tardify. Copy is approved positioning language (DOC/04); no
		     approved Tardify product screenshot exists in the repository yet
		     (see DOC/12), so this section is typography-only rather than a
		     placeholder standing in for real product evidence. -->
		<section class="section">
			<Container width="standard">
				<p class="eyebrow">Saját termékünk</p>
				<h2 style="margin-block-start: var(--space-sm); max-width: var(--content-reading);">
					Nem csak ügyfeleinknek építünk szoftvert.
				</h2>
				<p class="lead" style="max-width: var(--content-reading); margin-block-start: var(--space-md);">
					Amit ügyfeleinknek hosszú távú fejleszthetőségről mondunk, azt a saját
					termékünknél magunkon is számon kérjük.
				</p>
				<div class="meta-row" style="margin-block-start: var(--space-lg);">
					<a href="/tardify/" class="link-standalone">A Tardify története →</a>
					<a href="https://tardify.hu" class="link-standalone" rel="noopener">Tardify.hu →</a>
				</div>
			</Container>
		</section>

		<hr class="divider" />

		<!-- 07 — Process -->
		<section class="section">
			<Container width="standard">
				<p class="eyebrow">Nem a technológiával kezdjük.</p>
				<h2 style="margin-block-start: var(--space-sm); max-width: var(--content-reading);">
					Először a működést értjük meg. A technológia utána jön.
				</h2>

				<ol class="process-steps">
					<li class="process-steps__step">
						<span class="meta">01</span>
						<p class="process-steps__label">Megértjük</p>
					</li>
					<li class="process-steps__step">
						<span class="meta">02</span>
						<p class="process-steps__label">Megtervezzük</p>
					</li>
					<li class="process-steps__step">
						<span class="meta">03</span>
						<p class="process-steps__label">Megépítjük</p>
					</li>
					<li class="process-steps__step">
						<span class="meta">04</span>
						<p class="process-steps__label">Továbbfejlesztjük</p>
					</li>
				</ol>
			</Container>
		</section>

		<hr class="divider" />

		<!-- 08 — Senior / Who. No verified expert name/portrait exists yet
		     (see DOC/13) — copy only, no stock-photo substitute. -->
		<section class="section">
			<Container width="standard">
				<p class="eyebrow">Közvetlen együttműködés</p>
				<h2 style="margin-block-start: var(--space-sm); max-width: var(--content-reading);">
					A problémán tapasztalt fejlesztő dolgozik az első beszélgetéstől az
					éles rendszerig.
				</h2>
				<a href="/rolunk/" class="link-standalone" style="margin-block-start: var(--space-lg);">
					Rólunk →
				</a>
			</Container>
		</section>

		<hr class="divider" />

		<!-- 09 — Final CTA -->
		<section class="section section--major surface--tonal">
			<Container width="standard">
				<h2 style="max-width: var(--content-reading);">
					Van egy folyamat, amit ideje lenne jobban megoldani?
				</h2>
				<p class="lead" style="max-width: var(--content-reading); margin-block-start: var(--space-md);">
					Nem kell kész specifikációval érkeznie. Elég, ha elmondja, hogyan
					működik most, mi okozza a problémát, és mit szeretne jobban csinálni.
				</p>
				<a href="/kapcsolat/" class="btn btn-primary" style="margin-block-start: var(--space-xl);">
					Beszéljünk róla →
				</a>
			</Container>
		</section>
	</main>
</BaseLayout>
